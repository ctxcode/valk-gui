
+ enum PrimitiveKind { quad, shadow, text, image, line, circle, ring, triangle, clip, unclip }

/// One drawing command. Which fields matter depends on `kind`.
+ struct Primitive {
    + kind: PrimitiveKind
    + bounds: Bounds (.{})
    + color: Color (.{})
    + border_color: Color (.{})
    + border: Edges (.{})
    /// The radius of a circle or ring.
    + radius: f32 (0)
    /// The corner radii of a quad, shadow or image.
    + corners: Corners (.{})
    /// With `gradient`, the color `color` fades to.
    + color2: Color (.{})
    + gradient: bool (false)
    /// The gradient's angle, as in `Gradient`.
    + angle: f32 (180)
    + fit: ImageFit (.fill)
    /// The blur of a shadow, the width of a line or ring.
    + width: f32 (0)
    + text: String ("")
    + font: ResolvedFont (.{})
    /// Line end points, triangle corners.
    + points: [Point x 3] ({ .{}, .{}, .{} })
}

/// What a frame draws, in order. The window rebuilds it every frame.
+ class Scene {
    + items: Array[Primitive] (.{})

    + fn clear() { this.items.clear() }

    /// Every text drawn, in order.
    + fn texts() Array[String] {
        let result = Array[String]{}
        each this.items as item {
            if item.kind == .text : result.append(item.text)
        }
        return result
    }

    /// Whether a drawn text contains `part`.
    + fn has_text(part: String) bool {
        each this.items as item {
            if item.kind == .text && item.text.contains(part) : return true
        }
        return false
    }

    /// The first text that contains `part`.
    + fn find_text(part: String) ?Primitive {
        each this.items as item {
            if item.kind == .text && item.text.contains(part) : return item
        }
        return null
    }

    fn add(p: Primitive) { this.items.append(p) }
}

/// Draws into the scene from a `canvas` element. Coordinates are window coordinates; the
/// canvas's bounds are given next to the painter.
+ class Painter {
    window: Window
    alpha: f32 (1)
    /// The text color the canvas inherits, for drawing that should match the text around it.
    ~+ color: Color (.{ r: 255, g: 255, b: 255 })

    + fn fill(bounds: Bounds, color: Color, radius: f32 (0)) {
        this.window.scene.add(.{ kind: .quad, bounds: bounds, color: color.fade(this.alpha), corners: Corners.all(radius).clamp(bounds.w, bounds.h) })
    }

    /// A rectangle filled with a gradient; see `Gradient` for the angle.
    + fn fill_gradient(bounds: Bounds, from: Color, to: Color, angle: f32 (180), radius: f32 (0)) {
        this.window.scene.add(.{ kind: .quad, bounds: bounds, color: from.fade(this.alpha), color2: to.fade(this.alpha), gradient: true, angle: angle, corners: Corners.all(radius).clamp(bounds.w, bounds.h) })
    }

    + fn stroke(bounds: Bounds, color: Color, width: f32 (1), radius: f32 (0)) {
        this.window.scene.add(.{ kind: .quad, bounds: bounds, color: transparent(), border: Edges.all(width), border_color: color.fade(this.alpha), corners: Corners.all(radius).clamp(bounds.w, bounds.h) })
    }

    /// Connected lines through `points`, with round joins.
    + fn polyline(points: Array[Point], color: Color, width: f32 (1)) {
        let i: uint = 1
        while i < points.length {
            let a = points.get(i - 1) !!
            let b = points.get(i) !!
            this.line(a.x, a.y, b.x, b.y, color, width)
            i++
        }
    }

    /// An arc of a circle from angle `start` to `end`, in degrees clockwise from the right.
    + fn arc(x: f32, y: f32, radius: f32, start: f32, end: f32, color: Color, width: f32 (1)) {
        let steps = clamp32(ceil32((end - start).abs() / 10), 2, 72).to(uint)
        let points = Array[Point]{}
        each 0 .. steps + 1 as i {
            let a = (start + (end - start) * i.to(f32) / steps.to(f32)) * 0.017453292
            points.append(.{ x: x + cos32(a) * radius, y: y + sin32(a) * radius })
        }
        this.polyline(points, color, width)
    }

    + fn line(x1: f32, y1: f32, x2: f32, y2: f32, color: Color, width: f32 (1)) {
        this.window.scene.add(.{ kind: .line, color: color.fade(this.alpha), width: width, points: { .{ x: x1, y: y1 }, .{ x: x2, y: y2 }, .{} } })
    }

    + fn circle(x: f32, y: f32, radius: f32, color: Color) {
        this.window.scene.add(.{ kind: .circle, bounds: .{ x: x - radius, y: y - radius, w: radius * 2, h: radius * 2 }, color: color.fade(this.alpha), radius: radius })
    }

    + fn ring(x: f32, y: f32, radius: f32, color: Color, width: f32 (1)) {
        this.window.scene.add(.{ kind: .ring, bounds: .{ x: x - radius, y: y - radius, w: radius * 2, h: radius * 2 }, color: color.fade(this.alpha), radius: radius, width: width })
    }

    /// A filled triangle; the corners may be in either order.
    + fn triangle(a: Point, b: Point, c: Point, color: Color) {
        this.window.scene.add(.{ kind: .triangle, color: color.fade(this.alpha), points: { a, b, c } })
    }

    /// One line of text in a line box 1.4 times the size high, with its top-left corner at `x`, `y`.
    + fn text(x: f32, y: f32, content: String, color: Color, size: f32 (16), weight: FontWeight (.normal), font: String (""), italic: bool (false)) {
        let f = ResolvedFont{ name: font, size: size, weight: weight, italic: italic, line_height: round32(size * 1.4) }
        this.window.scene.add(.{ kind: .text, bounds: .{ x: x, y: y, w: this.window.platform.text_width(content, f), h: f.line_height }, color: color.fade(this.alpha), text: content, font: f })
    }

    + fn text_width(content: String, size: f32 (16), weight: FontWeight (.normal), font: String (""), italic: bool (false)) f32 {
        return this.window.platform.text_width(content, .{ name: font, size: size, weight: weight, italic: italic })
    }

    /// An image file drawn into `bounds`.
    + fn image(bounds: Bounds, path: String, radius: f32 (0), fit: ImageFit (.fill)) {
        this.window.scene.add(.{ kind: .image, bounds: bounds, color: white().fade(this.alpha), text: path, fit: fit, corners: Corners.all(radius).clamp(bounds.w, bounds.h) })
    }

    /// Limits drawing to `bounds` until `unclip`.
    + fn clip(bounds: Bounds) { this.window.push_clip(bounds) }
    + fn unclip() { this.window.pop_clip() }
}
