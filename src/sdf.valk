use raylib

// Rounded rectangles, borders, shadows, circles and lines drawn with a signed distance field
// in a fragment shader (assets/shaders/sdf.*): smooth edges at any size, without multisampling.

class Sdf {
    shader: raylib.Shader
    // Draws glyphs with steeper edges
    text: raylib.Shader
    rect: i32
    radius: i32
    border: i32
    blur: i32
    mode: i32
    fill: i32
    stroke: i32

    static fn load() Sdf {
        let s = raylib.load_shader_from_memory(#embed("assets/shaders/sdf.vs"), #embed("assets/shaders/sdf.fs"))
        return Sdf{
            shader: s, text: raylib.load_shader_from_memory("", #embed("assets/shaders/text.fs")), rect: s.location("rect"), radius: s.location("radius"), border: s.location("border"),
            blur: s.location("blur"), mode: s.location("mode"), fill: s.location("fill"), stroke: s.location("stroke")
        }
    }

    fn unload() {
        raylib.unload_shader(this.shader)
        raylib.unload_shader(this.text)
    }

    /// A box with rounded corners and a border inside its edge.
    fn box(b: Bounds, radius: f32, fill: Color, border: f32, stroke: Color) {
        this.draw(0, .{ x: b.x, y: b.y, z: b.w, w: b.h }, radius, border, 0, fill, stroke, b.grow(1))
    }

    fn shadow(b: Bounds, radius: f32, blur: f32, color: Color) {
        this.draw(1, .{ x: b.x, y: b.y, z: b.w, w: b.h }, radius, 0, blur, color, color, b.grow(blur * 1.5 + 1))
    }

    fn line(a: Point, b: Point, width: f32, color: Color) {
        let x = a.x.min(b.x)
        let y = a.y.min(b.y)
        let area = Bounds{ x: x, y: y, w: (a.x - b.x).abs(), h: (a.y - b.y).abs() }.grow(width / 2 + 1)
        this.draw(2, .{ x: a.x, y: a.y, z: b.x, w: b.y }, 0, width, 0, color, color, area)
    }

    - fn draw(mode: i32, shape: raylib.Vector4, radius: f32, border: f32, blur: f32, fill: Color, stroke: Color, area: Bounds) {
        let s = this.shader
        // Every draw has its own uniforms: switching the shader draws what was batched before
        raylib.begin_shader_mode(s)
        s.set_int(this.mode, mode)
        s.set_vec4(this.rect, shape)
        s.set_float(this.radius, radius)
        s.set_float(this.border, border)
        s.set_float(this.blur, blur)
        s.set_color(this.fill, to_rl(fill))
        s.set_color(this.stroke, to_rl(stroke))
        raylib.draw_rectangle_rec(rect(area), raylib.WHITE)
        raylib.end_shader_mode()
    }
}
