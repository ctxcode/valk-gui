use image

fn draw_scene(win: Window, p: SdlPlatform, canvas: Canvas) {
    let scale = canvas.scale
    canvas.reset_clip()
    canvas.clear(win.theme.background)
    each win.scene.items as item {
        match item.kind {
            .quad => draw_quad(item, canvas)
            .shadow => canvas.shadow(item.bounds, item.corners, item.width, item.color)
            .text => {
                let fonts = p.fonts
                let x = round32(item.bounds.x * scale) / scale
                let middle = (item.center_symbols ? fonts.symbol_middle(item.font, item.text) : null) ?? fonts.cap_middle(item.font)
                let y = floor32((item.bounds.y + item.font.line_height / 2 - middle) * scale + 0.499) / scale
                fonts.draw(canvas, item.text, item.font, x, y, item.color)
            }
            .image => {
                let img = p.load_image(item.text)
                if isset(img) : draw_image(item, img, canvas)
            }
            .line => canvas.line(item.points[0], item.points[1], item.width, item.color)
            .arc => canvas.arc(item.bounds.x, item.bounds.y, item.bounds.w, item.points[0].x, item.points[0].y, item.width, item.color)
            .circle => canvas.box(item.bounds, Corners.all(item.radius), item.color, 0, item.color)
            .ring => canvas.box(item.bounds, Corners.all(item.radius), transparent(), item.width, item.color)
            .triangle => canvas.triangle(item.points[0], item.points[1], item.points[2], item.color)
            .clip => canvas.set_clip(item.bounds)
            .unclip => canvas.reset_clip()
        }
    }
    canvas.reset_clip()
}

fn draw_quad(item: Primitive, canvas: Canvas) {
    let b = item.bounds
    if b.w <= 0 || b.h <= 0 : return
    let border = item.border
    let has_border = !border.is_zero() && !item.border_color.is_transparent()
    if item.gradient {
        canvas.gradient_box(b, item.corners, item.color, item.color2, item.angle, has_border && border.is_uniform() ? border.top : 0, item.border_color)
        return
    }
    if !item.corners.is_zero() || (has_border && border.is_uniform()) {
        let uniform = has_border && border.is_uniform()
        canvas.box(b, item.corners, item.color, uniform ? border.top : 0, item.border_color)
        if !has_border || uniform : return
    } else if !item.color.is_transparent() {
        canvas.fill_rect(b, item.color)
    }
    if has_border {
        let c = item.border_color
        if border.top > 0 : canvas.fill_rect(.{ x: b.x, y: b.y, w: b.w, h: border.top }, c)
        if border.bottom > 0 : canvas.fill_rect(.{ x: b.x, y: b.bottom - border.bottom, w: b.w, h: border.bottom }, c)
        if border.left > 0 : canvas.fill_rect(.{ x: b.x, y: b.y + border.top, w: border.left, h: b.h - border.top - border.bottom }, c)
        if border.right > 0 : canvas.fill_rect(.{ x: b.right - border.right, y: b.y + border.top, w: border.right, h: b.h - border.top - border.bottom }, c)
    }
}

fn draw_image(item: Primitive, img: image.Image, canvas: Canvas) {
    if img.width == 0 || img.height == 0 || item.bounds.w <= 0 || item.bounds.h <= 0 : return
    let tw = img.width.to(f32)
    let th = img.height.to(f32)
    let b = item.bounds
    let sx: f32 = 0
    let sy: f32 = 0
    let sw = tw
    let sh = th
    let dest = b
    if item.fit == .contain {
        let scale = (b.w / tw).min(b.h / th)
        dest = .{ x: b.x + (b.w - tw * scale) / 2, y: b.y + (b.h - th * scale) / 2, w: tw * scale, h: th * scale }
    } else if item.fit == .cover {
        let scale = (b.w / tw).max(b.h / th)
        sw = b.w / scale
        sh = b.h / scale
        sx = (tw - sw) / 2
        sy = (th - sh) / 2
    }
    canvas.draw_image(img, sx, sy, sw, sh, dest, item.corners, item.color)
}
