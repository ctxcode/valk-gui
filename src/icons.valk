
/// The built-in line icons (155+ icons including Git, editor, media, files, devices & UI).
+ enum Icon {
    // Original 50
    check, x, plus, minus
    chevron_down, chevron_up, chevron_left, chevron_right
    arrow_left, arrow_right, arrow_up, arrow_down
    search, menu, more, trash, edit, settings, home, user, file, folder
    star, heart, bell, calendar, copy, external, refresh, play, pause
    info, warning, sun, moon, grid, list, download, upload, filter
    lock, mail, code, terminal, clock, chart, bolt, eye, sidebar, circle
    // Git & VCS icons
    git_branch, git_merge, git_pull_request, git_commit, git_fork, git_diff
    repo, issue, issue_closed, tag, tags, history, shield, key
    // Arrows, chevrons & navigation
    chevrons_left, chevrons_right, chevrons_up, chevrons_down
    arrow_up_right, arrow_down_left, arrow_up_left, arrow_down_right
    corner_down_left, corner_down_right, undo, redo, repeat, shuffle
    maximize, minimize, expand, shrink, move_icon, grip_vertical, grip_horizontal
    // Files & folders
    file_plus, file_minus, file_text, file_code, file_image, file_archive
    folder_open, folder_plus, save, clipboard, clipboard_check, paperclip
    link, unlink, bookmark, book, inbox, archive, package_icon, database
    // Editor & formatting
    bold, italic, underline, strikethrough, align_left, align_center, align_right
    quote, hash, at_sign, slash, braces, brackets, heading, indent, outdent
    scissors, layers, sliders, palette, dropper, crop, zoom_in, zoom_out
    // Media & audio
    stop, skip_back, skip_forward, rewind, fast_forward
    volume, volume_low, volume_mute, mic, mic_off, camera, video, image_icon, music
    // Status, alerts & controls
    check_circle, x_circle, plus_circle, minus_circle, alert_circle, help_circle
    ban, check_square, square, eye_off, unlock, pin, flag, flame, sparkle
    // Communication & users
    users, user_plus, message, chat, send, phone, share, thumbs_up, thumbs_down
    // Devices, network & system
    globe, wifi, wifi_off, cloud, cloud_upload, cloud_download, server, cpu
    hard_drive, monitor, laptop, smartphone, printer, battery, power, log_in, log_out
    bell_off, compass, map_pin, bug, wrench, puzzle, rocket, trophy, gift, coffee
}

/// An icon drawn with lines in the current text color, `size` pixels square.
+ fn icon(name: Icon, size: f32 (16)) Div {
    return canvas(fn(p, b) { draw_icon(p, name, b, p.color) }).size(size).flex_shrink_0()
}

/// Draws an icon into `b` with the given color, for use in a canvas.
+ fn draw_icon(p: Painter, name: Icon, b: Bounds, color: Color) {
    let s = b.w.min(b.h) / 24
    let ox = b.x + (b.w - 24 * s) / 2
    let oy = b.y + (b.h - 24 * s) / 2
    let w = (1.75 * s).max(1.1)
    // Points in a 24 by 24 grid
    let pt = fn(x: f32, y: f32) Point { return .{ x: ox + x * s, y: oy + y * s } }
    let line = fn(x1: f32, y1: f32, x2: f32, y2: f32) { p.line(ox + x1 * s, oy + y1 * s, ox + x2 * s, oy + y2 * s, color, w) }
    let poly = fn(coords: Array[f32]) {
        let points = Array[Point]{}
        let i: uint = 0
        while i + 1 < coords.length {
            points.append(pt(coords.get(i) !? 0, coords.get(i + 1) !? 0))
            i += 2
        }
        p.polyline(points, color, w)
    }
    let ring = fn(x: f32, y: f32, r: f32) { p.ring(ox + x * s, oy + y * s, r * s + w / 2, color, w) }
    let dot = fn(x: f32, y: f32, r: f32) { p.circle(ox + x * s, oy + y * s, r * s, color) }
    let arc = fn(x: f32, y: f32, r: f32, a: f32, e: f32) { p.arc(ox + x * s, oy + y * s, r * s, a, e, color, w) }
    let box = fn(x: f32, y: f32, bw: f32, bh: f32, r: f32) { p.stroke(.{ x: ox + x * s - w / 2, y: oy + y * s - w / 2, w: bw * s + w, h: bh * s + w }, color, w, r * s) }
    let rays = fn(r1: f32, r2: f32, count: uint) {
        each 0 .. count as i {
            let a = i.to(f32) * 6.2831853 / count.to(f32)
            line(12 + cos32(a) * r1, 12 + sin32(a) * r1, 12 + cos32(a) * r2, 12 + sin32(a) * r2)
        }
    }
    match name {
        .check => poly(.{ 5, 12.5, 10, 17.5, 19, 7 })
        .x => {
            line(6, 6, 18, 18)
            line(18, 6, 6, 18)
        }
        .plus => {
            line(12, 5, 12, 19)
            line(5, 12, 19, 12)
        }
        .minus => line(5, 12, 19, 12)
        .chevron_down => poly(.{ 6, 9, 12, 15, 18, 9 })
        .chevron_up => poly(.{ 6, 15, 12, 9, 18, 15 })
        .chevron_left => poly(.{ 15, 6, 9, 12, 15, 18 })
        .chevron_right => poly(.{ 9, 6, 15, 12, 9, 18 })
        .arrow_left => {
            line(19, 12, 5, 12)
            poly(.{ 11, 6, 5, 12, 11, 18 })
        }
        .arrow_right => {
            line(5, 12, 19, 12)
            poly(.{ 13, 6, 19, 12, 13, 18 })
        }
        .arrow_up => {
            line(12, 19, 12, 5)
            poly(.{ 6, 11, 12, 5, 18, 11 })
        }
        .arrow_down => {
            line(12, 5, 12, 19)
            poly(.{ 6, 13, 12, 19, 18, 13 })
        }
        .search => {
            ring(10.5, 10.5, 6)
            line(15, 15, 20, 20)
        }
        .menu => {
            line(4, 6, 20, 6)
            line(4, 12, 20, 12)
            line(4, 18, 20, 18)
        }
        .more => {
            dot(5.5, 12, 1.7)
            dot(12, 12, 1.7)
            dot(18.5, 12, 1.7)
        }
        .trash => {
            line(4, 7, 20, 7)
            poly(.{ 9, 7, 9, 4.5, 15, 4.5, 15, 7 })
            poly(.{ 6, 7, 7, 20, 17, 20, 18, 7 })
            line(10, 11, 10, 16)
            line(14, 11, 14, 16)
        }
        .edit => {
            poly(.{ 4, 20, 4.5, 15.5, 15.5, 4.5, 19.5, 8.5, 8.5, 19.5, 4, 20 })
            line(13, 7, 17, 11)
        }
        .settings => {
            ring(12, 12, 3)
            ring(12, 12, 7)
            rays(7.5, 10, 8)
        }
        .home => {
            poly(.{ 3, 11, 12, 3.5, 21, 11 })
            poly(.{ 5.5, 9, 5.5, 20, 18.5, 20, 18.5, 9 })
            poly(.{ 10, 20, 10, 14, 14, 14, 14, 20 })
        }
        .user => {
            ring(12, 8, 4)
            arc(12, 22, 8.5, 205, 335)
        }
        .file => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 })
            poly(.{ 14, 3, 14, 8, 19, 8 })
        }
        .folder => poly(.{ 3, 6, 3, 19, 21, 19, 21, 8.5, 11.5, 8.5, 9.5, 5.5, 3, 5.5, 3, 6 })
        .star => {
            let points = Array[f32]{}
            each 0 .. 11 as i {
                let a = -1.5707963 + i.to(f32) * 3.14159265 / 5
                let r: f32 = i % 2 == 0 ? 9.5 : 4.2
                points.append(12 + cos32(a) * r)
                points.append(12.8 + sin32(a) * r)
            }
            poly(points)
        }
        .heart => {
            arc(7.75, 9, 4.75, 140, 360)
            arc(16.25, 9, 4.75, 180, 400)
            poly(.{ 4.1, 12.05, 12, 20, 19.9, 12.05 })
        }
        .bell => {
            arc(12, 11, 6, 180, 360)
            line(6, 11, 6, 16)
            line(18, 11, 18, 16)
            line(4, 17, 20, 17)
            line(10, 20.5, 14, 20.5)
        }
        .calendar => {
            box(4, 5, 16, 15, 2)
            line(4, 10, 20, 10)
            line(8, 3, 8, 7)
            line(16, 3, 16, 7)
        }
        .copy => {
            box(9, 9, 11, 11, 2)
            poly(.{ 15, 9, 15, 4, 4, 4, 4, 15, 9, 15 })
        }
        .external => {
            poly(.{ 14, 4, 20, 4, 20, 10 })
            line(20, 4, 11, 13)
            poly(.{ 18, 14, 18, 20, 4, 20, 4, 6, 10, 6 })
        }
        .refresh => {
            arc(12, 12, 8.5, 32, 332)
            line(19.8, 3.5, 19.8, 8.0)
            line(15.3, 8.0, 19.8, 8.0)
        }
        .play => p.triangle(pt(8, 5), pt(19.5, 12), pt(8, 19), color)
        .pause => {
            p.fill(.{ x: ox + 6.5 * s, y: oy + 5 * s, w: 3.5 * s, h: 14 * s }, color, s)
            p.fill(.{ x: ox + 14 * s, y: oy + 5 * s, w: 3.5 * s, h: 14 * s }, color, s)
        }
        .info => {
            ring(12, 12, 9)
            line(12, 11, 12, 16.5)
            dot(12, 7.8, 1.25)
        }
        .warning => {
            poly(.{ 12, 3.5, 21.5, 20, 2.5, 20, 12, 3.5 })
            line(12, 9.5, 12, 14)
            dot(12, 17, 1.2)
        }
        .sun => {
            ring(12, 12, 4)
            rays(7, 9.5, 8)
        }
        .moon => {
            arc(12, 12.5, 8.5, 11.2, 264.8)
            arc(17, 8, 7, 214.5, 61.5)
        }
        .grid => {
            box(4, 4, 6.5, 6.5, 1.5)
            box(13.5, 4, 6.5, 6.5, 1.5)
            box(4, 13.5, 6.5, 6.5, 1.5)
            box(13.5, 13.5, 6.5, 6.5, 1.5)
        }
        .list => {
            dot(5, 6.5, 1.4)
            dot(5, 12, 1.4)
            dot(5, 17.5, 1.4)
            line(9, 6.5, 20, 6.5)
            line(9, 12, 20, 12)
            line(9, 17.5, 20, 17.5)
        }
        .download => {
            line(12, 4, 12, 15)
            poly(.{ 7, 10, 12, 15, 17, 10 })
            line(5, 20, 19, 20)
        }
        .upload => {
            line(12, 15, 12, 4)
            poly(.{ 7, 9, 12, 4, 17, 9 })
            line(5, 20, 19, 20)
        }
        .filter => poly(.{ 4, 5, 20, 5, 14, 12.5, 14, 19, 10, 17, 10, 12.5, 4, 5 })
        .lock => {
            box(5, 11, 14, 10, 2)
            arc(12, 11, 4.5, 180, 360)
        }
        .mail => {
            box(3, 5, 18, 14, 2)
            poly(.{ 4, 6.5, 12, 13, 20, 6.5 })
        }
        .code => {
            poly(.{ 8, 7, 3, 12, 8, 17 })
            poly(.{ 16, 7, 21, 12, 16, 17 })
        }
        .terminal => {
            poly(.{ 5, 8, 9, 12, 5, 16 })
            line(11, 16, 19, 16)
        }
        .clock => {
            ring(12, 12, 9)
            poly(.{ 12, 7, 12, 12, 15.5, 14 })
        }
        .chart => {
            line(3, 20, 21, 20)
            line(7, 17, 7, 12)
            line(12, 17, 12, 6)
            line(17, 17, 17, 10)
        }
        .bolt => poly(.{ 13, 3, 5, 13.5, 12, 13.5, 11, 21, 19, 10.5, 12, 10.5, 13, 3 })
        .eye => {
            arc(12, 21, 12, 222, 318)
            arc(12, 3, 12, 42, 138)
            ring(12, 12, 3)
        }
        .sidebar => {
            box(3, 4, 18, 16, 2)
            line(9, 4, 9, 20)
        }
        .circle => ring(12, 12, 8)
        // ---- Git & VCS ----
        .git_branch => {
            ring(6, 6, 2.5); ring(6, 18, 2.5); ring(18, 8, 2.5)
            line(6, 8.5, 6, 15.5)
            poly(.{ 18, 10.5, 18, 13, 6, 15.5 })
        }
        .git_merge => {
            ring(6, 6, 2.5); ring(6, 18, 2.5); ring(18, 16, 2.5)
            line(6, 8.5, 6, 15.5)
            poly(.{ 6, 8.5, 10, 14, 15.5, 16 })
        }
        .git_pull_request => {
            ring(6, 6, 2.5); ring(6, 18, 2.5); ring(18, 18, 2.5)
            line(6, 8.5, 6, 15.5)
            poly(.{ 13, 6, 18, 6, 18, 15.5 })
            poly(.{ 15, 4, 13, 6, 15, 8 })
        }
        .git_commit => {
            ring(12, 12, 3.5)
            line(3, 12, 8.5, 12)
            line(15.5, 12, 21, 12)
        }
        .git_fork => {
            ring(6, 6, 2.5); ring(18, 6, 2.5); ring(12, 18, 2.5)
            poly(.{ 6, 8.5, 6, 12, 18, 12, 18, 8.5 })
            line(12, 12, 12, 15.5)
        }
        .git_diff => {
            line(12, 4, 12, 12); line(8, 8, 16, 8)
            line(8, 18, 16, 18)
        }
        .repo => {
            box(4, 3, 16, 18, 2)
            line(8, 3, 8, 21)
            line(8, 16, 20, 16)
        }
        .issue => {
            ring(12, 12, 9)
            dot(12, 12, 2)
        }
        .issue_closed => {
            ring(12, 12, 9)
            poly(.{ 8, 12.5, 11, 15.5, 16, 9.5 })
        }
        .tag => {
            poly(.{ 3, 12, 3, 4, 11, 4, 20.5, 13.5, 12.5, 21.5, 3, 12 })
            dot(7.5, 8.5, 1.3)
        }
        .tags => {
            poly(.{ 3, 12, 3, 5, 10, 5, 18, 13, 11, 20, 3, 12 })
            poly(.{ 13, 5, 21, 13, 15, 19 })
            dot(7, 9, 1.2)
        }
        .history => {
            arc(12, 12, 8.5, 40, 340)
            poly(.{ 3.5, 5, 3.5, 10, 8.5, 10 })
            poly(.{ 12, 7.5, 12, 12, 15.5, 14 })
        }
        .shield => poly(.{ 12, 3, 20, 6, 20, 12, 12, 21, 4, 12, 4, 6, 12, 3 })
        .key => {
            ring(7.5, 12, 4)
            line(11.5, 12, 21, 12)
            line(18, 12, 18, 16)
            line(15, 12, 15, 15)
        }
        // ---- Arrows & navigation ----
        .chevrons_left => { poly(.{ 11, 6, 5, 12, 11, 18 }); poly(.{ 18, 6, 12, 12, 18, 18 }) }
        .chevrons_right => { poly(.{ 6, 6, 12, 12, 6, 18 }); poly(.{ 13, 6, 19, 12, 13, 18 }) }
        .chevrons_up => { poly(.{ 6, 11, 12, 5, 18, 11 }); poly(.{ 6, 18, 12, 12, 18, 18 }) }
        .chevrons_down => { poly(.{ 6, 6, 12, 12, 18, 6 }); poly(.{ 6, 13, 12, 19, 18, 13 }) }
        .arrow_up_right => { line(6, 18, 18, 6); poly(.{ 9, 6, 18, 6, 18, 15 }) }
        .arrow_down_left => { line(18, 6, 6, 18); poly(.{ 15, 18, 6, 18, 6, 9 }) }
        .arrow_up_left => { line(18, 18, 6, 6); poly(.{ 15, 6, 6, 6, 6, 15 }) }
        .arrow_down_right => { line(6, 6, 18, 18); poly(.{ 18, 9, 18, 18, 9, 18 }) }
        .corner_down_left => { poly(.{ 19, 5, 19, 14, 5, 14 }); poly(.{ 10, 9, 5, 14, 10, 19 }) }
        .corner_down_right => { poly(.{ 5, 5, 5, 14, 19, 14 }); poly(.{ 14, 9, 19, 14, 14, 19 }) }
        .undo => { arc(12, 14, 7, 200, 360); poly(.{ 4, 6, 4, 12, 10, 12 }) }
        .redo => { arc(12, 14, 7, 180, 340); poly(.{ 20, 6, 20, 12, 14, 12 }) }
        .repeat => {
            poly(.{ 4, 10, 4, 7, 19, 7 }); poly(.{ 16, 4, 19, 7, 16, 10 })
            poly(.{ 20, 14, 20, 17, 5, 17 }); poly(.{ 8, 14, 5, 17, 8, 20 })
        }
        .shuffle => {
            poly(.{ 4, 17, 10, 17, 15, 7, 20, 7 }); poly(.{ 17, 4, 20, 7, 17, 10 })
            poly(.{ 4, 7, 10, 7, 15, 17, 20, 17 }); poly(.{ 17, 14, 20, 17, 17, 20 })
        }
        .maximize => {
            poly(.{ 4, 9, 4, 4, 9, 4 }); poly(.{ 15, 4, 20, 4, 20, 9 })
            poly(.{ 20, 15, 20, 20, 15, 20 }); poly(.{ 9, 20, 4, 20, 4, 15 })
        }
        .minimize => {
            poly(.{ 9, 4, 9, 9, 4, 9 }); poly(.{ 15, 4, 15, 9, 20, 9 })
            poly(.{ 20, 15, 15, 15, 15, 20 }); poly(.{ 4, 15, 9, 15, 9, 20 })
        }
        .expand => { line(14, 10, 20, 4); poly(.{ 15, 4, 20, 4, 20, 9 }); line(10, 14, 4, 20); poly(.{ 9, 20, 4, 20, 4, 15 }) }
        .shrink => { line(20, 4, 14, 10); poly(.{ 14, 5, 14, 10, 19, 10 }); line(4, 20, 10, 14); poly(.{ 10, 19, 10, 14, 5, 14 }) }
        .move_icon => {
            line(12, 3, 12, 21); line(3, 12, 21, 12)
            poly(.{ 9, 6, 12, 3, 15, 6 }); poly(.{ 9, 18, 12, 21, 15, 18 })
            poly(.{ 6, 9, 3, 12, 6, 15 }); poly(.{ 18, 9, 21, 12, 18, 15 })
        }
        .grip_vertical => {
            dot(9, 6, 1.3); dot(15, 6, 1.3); dot(9, 12, 1.3); dot(15, 12, 1.3); dot(9, 18, 1.3); dot(15, 18, 1.3)
        }
        .grip_horizontal => {
            dot(6, 9, 1.3); dot(12, 9, 1.3); dot(18, 9, 1.3); dot(6, 15, 1.3); dot(12, 15, 1.3); dot(18, 15, 1.3)
        }
        // ---- Files & folders ----
        .file_plus => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 }); poly(.{ 14, 3, 14, 8, 19, 8 })
            line(12.5, 12, 12.5, 18); line(9.5, 15, 15.5, 15)
        }
        .file_minus => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 }); poly(.{ 14, 3, 14, 8, 19, 8 })
            line(9.5, 15, 15.5, 15)
        }
        .file_text => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 }); poly(.{ 14, 3, 14, 8, 19, 8 })
            line(9, 13, 16, 13); line(9, 17, 16, 17)
        }
        .file_code => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 }); poly(.{ 14, 3, 14, 8, 19, 8 })
            poly(.{ 10.5, 13, 8.5, 15, 10.5, 17 }); poly(.{ 14.5, 13, 16.5, 15, 14.5, 17 })
        }
        .file_image => {
            poly(.{ 6, 3, 14, 3, 19, 8, 19, 21, 6, 21, 6, 3 }); poly(.{ 14, 3, 14, 8, 19, 8 })
            poly(.{ 7, 19, 11, 14, 14, 17, 16, 15, 18.5, 19 })
        }
        .file_archive => {
            box(5, 3, 14, 18, 2); line(12, 3, 12, 15); box(10, 15, 4, 3, 1)
        }
        .folder_open => {
            poly(.{ 3, 6, 3, 19, 19, 19, 21.5, 11, 6.5, 11, 3, 19 })
            poly(.{ 3, 6, 9, 6, 11, 8.5, 19, 8.5, 19, 11 })
        }
        .folder_plus => {
            poly(.{ 3, 6, 3, 19, 21, 19, 21, 8.5, 11.5, 8.5, 9.5, 5.5, 3, 5.5, 3, 6 })
            line(12, 11.5, 12, 16.5); line(9.5, 14, 14.5, 14)
        }
        .save => {
            poly(.{ 4, 4, 16, 4, 20, 8, 20, 20, 4, 20, 4, 4 })
            box(8, 4, 7, 5, 0); box(7, 13, 10, 7, 1)
        }
        .clipboard => {
            box(5, 5, 14, 16, 2); box(9, 3, 6, 3.5, 1)
        }
        .clipboard_check => {
            box(5, 5, 14, 16, 2); box(9, 3, 6, 3.5, 1)
            poly(.{ 9, 13.5, 11.5, 16, 15.5, 11 })
        }
        .paperclip => {
            poly(.{ 19, 11, 11, 19, 5.5, 13.5, 14, 5, 17.5, 8.5, 10, 16, 8, 14, 14.5, 7.5 })
        }
        .link => {
            box(3, 9, 9, 6, 3); box(12, 9, 9, 6, 3); line(9, 12, 15, 12)
        }
        .unlink => {
            box(3, 9, 7, 6, 3); box(14, 9, 7, 6, 3); line(4, 4, 20, 20)
        }
        .bookmark => poly(.{ 6, 3, 18, 3, 18, 21, 12, 16.5, 6, 21, 6, 3 })
        .book => {
            poly(.{ 4, 4, 12, 5.5, 20, 4, 20, 19, 12, 20.5, 4, 19, 4, 4 })
            line(12, 5.5, 12, 20.5)
        }
        .inbox => {
            poly(.{ 4, 13, 6, 5, 18, 5, 20, 13, 20, 19, 4, 19, 4, 13 })
            poly(.{ 4, 13, 9, 13, 10.5, 15.5, 13.5, 15.5, 15, 13, 20, 13 })
        }
        .archive => {
            box(3, 4, 18, 4, 1); box(4.5, 8, 15, 12, 1); line(10, 13, 14, 13)
        }
        .package_icon => {
            poly(.{ 12, 3, 20, 7.5, 20, 16.5, 12, 21, 4, 16.5, 4, 7.5, 12, 3 })
            poly(.{ 4, 7.5, 12, 12, 20, 7.5 }); line(12, 12, 12, 21)
        }
        .database => {
            box(4, 4, 16, 5, 2.5); line(4, 6.5, 4, 17.5); line(20, 6.5, 20, 17.5)
            arc(12, 12, 8, 20, 160); arc(12, 17.5, 8, 20, 160)
        }
        // ---- Editor & formatting ----
        .bold => {
            poly(.{ 6, 4, 14, 4, 16.5, 6.5, 16.5, 9.5, 14, 11.5, 6, 11.5, 6, 4 })
            poly(.{ 6, 11.5, 15, 11.5, 18, 14, 18, 17.5, 15, 20, 6, 20, 6, 11.5 })
        }
        .italic => { line(10, 4, 19, 4); line(5, 20, 14, 20); line(14.5, 4, 9.5, 20) }
        .underline => {
            poly(.{ 6, 4, 6, 12, 9, 16, 15, 16, 18, 12, 18, 4 })
            line(5, 20, 19, 20)
        }
        .strikethrough => {
            line(4, 12, 20, 12)
            poly(.{ 16, 6.5, 14, 4.5, 9.5, 4.5, 7.5, 6.5, 7.5, 9 })
            poly(.{ 8, 17.5, 10, 19.5, 14.5, 19.5, 16.5, 17.5, 16.5, 15 })
        }
        .align_left => { line(4, 6, 20, 6); line(4, 10.5, 14, 10.5); line(4, 15, 18, 15); line(4, 19.5, 12, 19.5) }
        .align_center => { line(4, 6, 20, 6); line(7, 10.5, 17, 10.5); line(5, 15, 19, 15); line(8, 19.5, 16, 19.5) }
        .align_right => { line(4, 6, 20, 6); line(10, 10.5, 20, 10.5); line(6, 15, 20, 15); line(12, 19.5, 20, 19.5) }
        .quote => { box(4, 8, 6, 6, 1); line(10, 14, 8, 18); box(14, 8, 6, 6, 1); line(20, 14, 18, 18) }
