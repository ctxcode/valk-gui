use valk.fs

// stb_truetype / TrueType sizes fonts by ascent to descent; this makes the em the requested size
value EM_SCALE (1.21)

// Font files with wide coverage, tried for characters the font in use lacks
fn system_fallback_fonts() Array[String] {
    #if OS == "macos"
    return .{ "/System/Library/Fonts/Supplemental/Arial Unicode.ttf", "/System/Library/Fonts/Hiragino Sans GB.ttc",
        "/System/Library/Fonts/AppleSDGothicNeo.ttc", "/System/Library/Fonts/Apple Symbols.ttf",
        "/System/Library/Fonts/Apple Color Emoji.ttc" }
    #elif OS == "win"
    return .{ "C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/msyh.ttc", "C:/Windows/Fonts/YuGothM.ttc",
        "C:/Windows/Fonts/malgun.ttf", "C:/Windows/Fonts/seguisym.ttf", "C:/Windows/Fonts/seguiemj.ttf" }
    #else
    return .{ "/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/noto/NotoSans-Regular.ttf", "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
        "/usr/share/fonts/wenquanyi/wqy-microhei/wqy-microhei.ttc",
        "/usr/share/fonts/noto/NotoSansSymbols2-Regular.ttf", "/usr/share/fonts/truetype/noto/NotoSansSymbols2-Regular.ttf",
        "/usr/share/fonts/noto/NotoColorEmoji.ttf", "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf" }
    #end
}

// Alpha-weighted vertical center of a glyph's ink below the top of the text, in logical pixels.
fn glyph_optical_middle(face: Face, codepoint: u32, scale: f32) f32 {
    let g = face.glyph(codepoint)
    let iw = g.width
    let ih = g.height
    if iw > 0 && ih > 0 && g.bitmap.length >= (iw * ih).to(uint) {
        let weighted: f32 = 0
        let total: f32 = 0
        let bm = g.bitmap
        let uw = iw.to(uint)
        let y: i32 = 0
        while y < ih {
            let row_sum: f32 = 0
            let row = y.to(uint) * uw
            let x: i32 = 0
            while x < iw {
                row_sum += bm[row + x.to(uint)].to(f32)
                x++
            }
            weighted += row_sum * (g.offset_y.to(f32) + y.to(f32) + 0.5)
            total += row_sum
            y++
        }
        if total > 0 : return (weighted / total) / scale
    }
    return (g.offset_y.to(f32) + ih.to(f32) / 2) / scale
}

// One font file rasterized lazily at one pixel size.
class Face {
    key: u64 (0)
    ttf: TtfFont
    px: f32
    scale: f32
    glyphs: HashMap[u32, RasterGlyph] (.{})
    ascii: [?RasterGlyph x 128] ({ null ... })
    // The logical size, distance to baseline, and optical center of a capital letter
    size: f32
    baseline: f32
    cap_mid: f32

    fn kern(left_cp: u32, right_cp: u32) f32 {
        return this.ttf.kern_advance(left_cp, right_cp, this.px)
    }

    fn glyph(cp: u32) RasterGlyph {
        if cp < 128 {
            let fast = this.ascii[cp.to(uint)]
            if isset(fast) : return fast
            let g = this.ttf.rasterize(cp, this.px)
            this.ascii[cp.to(uint)] = g
            return g
        }
        let cached = this.glyphs.get(cp) !? null
        if isset(cached) : return cached
        let color_g = this.ttf.rasterize_color_emoji(this.ttf.glyph_index(cp), this.px)
        let g = isset(color_g) ? color_g : this.ttf.rasterize(cp, this.px)
        this.glyphs.set(cp, g)
        return g
    }

    fn has_glyph(cp: u32) bool {
        return this.ttf.has_codepoint(cp)
    }

    fn measure(text: String) f32 {
        let total: f32 = 0
        let i: uint = 0
        let prev_cp: u32 = 0
        while i < text.length {
            let cp, len = decode_utf8(text, i)
            i += len
            if is_zero_width(cp) || is_combining_mark(cp) : continue
            if prev_cp != 0 : total += this.kern(prev_cp, cp)
            prev_cp = cp
            let g = this.glyph(cp)
            total += g.advance
        }
        return total / this.scale
    }
}

struct Run {
    face: Face
    text: String
}

/// Loads TrueType fonts from memory and caches rasterized glyphs lazily per codepoint and size.
class Fonts {
    window: ?Window (null)
    scale: f32 (1.0)
    faces: HashMap[u64, Face] (.{})
    parsed: Map[TtfFont] (.{})
    files: Map[String] (.{})
    fallbacks: Array[String] (.{})
    visual: Map[String] (.{})
    lut_cache: HashMap[u32, [u8 x 256]] (.{})

    static fn new(extra_fallbacks: Array[String], scale: f32 (1.0)) Fonts {
        let f = Fonts{ scale: scale.max(1.0) }
        each extra_fallbacks as path : f.fallbacks.append(path)
        each system_fallback_fonts() as path {
            if fs.is_file(path) : f.fallbacks.append(path)
        }
        return f
    }

    fn set_scale(scale: f32) {
        let s = scale.max(1.0)
        if (s - this.scale).abs() > 0.01 {
            this.scale = s
            this.faces.clear()
        }
    }

    /// The face of a font family at a size, `fallback` 0 for the family itself and 1.. for the
    /// fallback fonts.
    fn face(font: ResolvedFont, fallback: uint) Face {
        let size_key = round32(font.size * 8).to(u64)
        let key = fallback == 0 ? font_key(font, size_key) : (fallback.to(u64) << 40) + (font.weight.to(u64) << 32) + size_key
        let cached = this.faces.get(key) !? null
        if isset(cached) : return cached

        let ttf = fallback == 0 ? this.family_ttf(font.name, font.weight, font.italic) : this.file_ttf(this.fallbacks.get(fallback - 1) !? "")
        if !ttf.valid : ttf = this.builtin_ttf(font.weight, font.italic)

        let ratio, ascent = ttf_metrics(ttf)
        let scale = this.scale
        let px = round32(font.size * ratio * scale).max(4.0)
        let size = px / scale
        let face = Face{
            key: key, ttf: ttf, px: px, scale: scale,
            size: size, baseline: size * ascent / ratio, cap_mid: 0
        }
        face.cap_mid = glyph_optical_middle(face, 72, scale)
        this.faces.set(key, face)
        return face
    }

    /// The text cut into parts that one face draws.
    fn runs(logical: String, font: ResolvedFont) Array[Run] {
        let text = this.ordered(logical)
        let primary = this.face(font, 0)
        let result = Array[Run]{}
        if is_ascii(text) {
            result.append(.{ face: primary, text: text })
            return result
        }
        let start: uint = 0
        let current = primary
        let i: uint = 0
        while i < text.length {
            let cp, len = decode_utf8(text, i)
            let face = this.face_for(font, primary, cp)
            if face != current {
                if i > start : result.append(.{ face: current, text: text.range(start, i - start) })
                start = i
                current = face
            }
            i += len
        }
        if text.length > start : result.append(.{ face: current, text: text.range(start, text.length - start) })
        return result
    }

    - fn ordered(text: String) String {
        if !has_rtl(text) : return text
        let cached = this.visual.get(text) !? null
        if isset(cached) : return cached
        if this.visual.length > 4000 : this.visual.clear()
        let v = visual_text(text)
        this.visual.set(text, v)
        return v
    }

    - fn face_for(font: ResolvedFont, primary: Face, cp: u32) Face {
        if cp < 0x80 || primary.has_glyph(cp) : return primary
        each this.fallbacks as _, i {
            let face = this.face(font, i + 1)
            if face.has_glyph(cp) : return face
        }
        return primary
    }

    fn text_lut(color: Color) [u8 x 256] {
        let key: u32 = color.r.to(u32) | (color.g.to(u32) << 8) | (color.b.to(u32) << 16) | (color.a.to(u32) << 24)
        let cached = this.lut_cache.get(key) !? null
        if isset(cached) : return cached
        if this.lut_cache.length >= 64 : this.lut_cache.clear()
        let lut = build_text_alpha_lut(color)
        this.lut_cache.set(key, lut)
        return lut
    }

    fn width(text: String, font: ResolvedFont) f32 {
        if text.length == 0 : return 0
        if is_ascii(text) : return this.face(font, 0).measure(text)
        let w: f32 = 0
        each this.runs(text, font) as run : w += run.face.measure(run.text)
        return w
    }

    fn draw(canvas: Canvas, text: String, font: ResolvedFont, x: f32, y: f32, color: Color) {
        if text.length == 0 || color.a == 0 : return
        let primary = this.face(font, 0)
        let scale = this.scale
        let lut = this.text_lut(color)
        let pos_px = round32(x * scale)
        if is_ascii(text) {
            let dy_px = round32(y * scale).to(i32)
            let i: uint = 0
            let prev_cp: u32 = 0
            while i < text.length {
                let cp = text[i].to(u32)
                if prev_cp != 0 : pos_px += primary.kern(prev_cp, cp)
                prev_cp = cp
                let g = primary.glyph(cp)
                if g.width > 0 && g.height > 0 {
                    canvas.blit_glyph(g, round32(pos_px).to(i32) + g.offset_x, dy_px + g.offset_y, color, lut)
                }
                pos_px += g.advance
                i++
            }
            return
        }
        each this.runs(text, font) as run {
            let dy_px = round32((y + primary.baseline - run.face.baseline) * scale).to(i32)
            let i: uint = 0
            let prev_cp: u32 = 0
            let last_adv: f32 = 0
            while i < run.text.length {
                let cp, len = decode_utf8(run.text, i)
                i += len
                if is_zero_width(cp) : continue
                let combining = is_combining_mark(cp)
                if !combining && prev_cp != 0 : pos_px += run.face.kern(prev_cp, cp)
                let g = run.face.glyph(cp)
                if g.width > 0 && g.height > 0 {
                    let gx = combining ? round32(pos_px - last_adv * 0.5).to(i32) - g.width / 2 : round32(pos_px).to(i32) + g.offset_x
                    let gy = dy_px + g.offset_y
                    if g.is_color {
                        canvas.blit_color_glyph(g, gx, gy, color.a)
                    } else {
                        canvas.blit_glyph(g, gx, gy, color, lut)
                    }
                }
                if !combining {
                    prev_cp = cp
                    last_adv = g.advance
                    pos_px += g.advance
                }
            }
        }
    }

    /// Where the optical middle of a capital letter is below the top of the text, in logical pixels.
    fn cap_middle(font: ResolvedFont) f32 {
        return this.face(font, 0).cap_mid
    }

    /// For text made only of symbols, such as "+" or "×": the middle of its ink below the top of
    /// the text, in logical pixels. Symbols sit at different heights, so they center on themselves.
    fn symbol_middle(font: ResolvedFont, text: String) ?f32 {
        if text.length == 0 : return null
        // Fast bailout: almost all labels contain ASCII letters/digits
        let k: uint = 0
        while k < text.length {
            let b = text[k].to(u32)
            if b < 0x80 && b != ' ' && !is_symbol(b) : return null
            if b >= 0x80 : break
            k++
        }
        let primary = this.face(font, 0)
        let scale = this.scale
        let top: f32 = INF
        let bottom: f32 = -INF
        each this.runs(text, font) as run {
            let shift = primary.baseline - run.face.baseline
            let i: uint = 0
            while i < run.text.length {
                let cp, len = decode_utf8(run.text, i)
                i += len
                if cp == ' ' : continue
                if !is_symbol(cp) : return null
                let g = run.face.glyph(cp)
                if g.height <= 0 : continue
                top = top.min(g.offset_y.to(f32) / scale + shift)
                bottom = bottom.max((g.offset_y + g.height).to(f32) / scale + shift)
            }
        }
        if top > bottom : return null
        return (top + bottom) / 2
    }

    - fn family_ttf(name: String, weight: FontWeight, italic: bool) TtfFont {
        if name == "" : return this.builtin_ttf(weight, italic)
        let win = this.window ?! return this.builtin_ttf(weight, italic)
        let best: ?String = null
        let best_distance: int = 100
        each win.fonts as f {
            if f.name != name : continue
            let d = (f.weight.to(int) - weight.to(int)).abs()
            if d < best_distance {
                best = f.path
                best_distance = d
            }
        }
        if !isset(best) : return this.builtin_ttf(weight, italic)
        let ttf = this.file_ttf(best)
        return ttf.valid ? ttf : this.builtin_ttf(weight, italic)
    }

    - fn builtin_ttf(weight: FontWeight, italic: bool) TtfFont {
        let key = italic ? "__builtin_italic" : "__builtin_" + weight.to(int)
        let cached = this.parsed.get(key) !? null
        if isset(cached) : return cached
        let ttf = TtfFont.parse(builtin_font(weight, italic))
        this.parsed.set(key, ttf)
        return ttf
    }

    - fn file_ttf(path: String) TtfFont {
        if path.length == 0 : return TtfFont{ data: "" }
        let cached = this.parsed.get(path) !? null
        if isset(cached) : return cached
        let data = fs.read(path) !? ""
        let ttf = TtfFont.parse(data)
        this.parsed.set(path, ttf)
        return ttf
    }

    fn unload() {
        this.faces.clear()
        this.parsed.clear()
    }
}

fn ttf_metrics(ttf: TtfFont) (f32, f32) {
    if !ttf.valid || ttf.units_per_em <= 0 || ttf.ascent - ttf.descent <= 0 : return (EM_SCALE, 0.97)
    let units = ttf.units_per_em
    return ((ttf.ascent - ttf.descent).to(f32) / units, ttf.ascent.to(f32) / units)
}

/// A font collection (.ttc) turned into a plain font file of its first font: that font's table
/// directory is written over the collection header. Table offsets count from the file start, so
/// they stay valid.
fn ttc_first_font(data: String) String {
    if data.length < 16 || data.range(0, 4) != "ttcf" : return data
    let offset = read_u32(data, 12).to(uint)
    if offset + 12 > data.length : return data
    let tables = read_u16(data, offset + 4).to(uint)
    let dir = 12 + 16 * tables
    if offset + dir > data.length : return data
    return data.range(offset, dir) + data.range(dir, data.length - dir)
}

fn read_u32(d: String, at: uint) u32 {
    return (d[at].to(u32) << 24) | (d[at + 1].to(u32) << 16) | (d[at + 2].to(u32) << 8) | d[at + 3].to(u32)
}
fn read_u16(d: String, at: uint) u32 {
    return (d[at].to(u32) << 8) | d[at + 1].to(u32)
}

fn is_zero_width(cp: u32) bool {
    return cp == 0x200b || cp == 0x200c || cp == 0x200d || cp == 0xfeff || (cp >= 0xfe00 && cp <= 0xfe0f)
}

fn is_combining_mark(cp: u32) bool {
    return (cp >= 0x0300 && cp <= 0x036f) || (cp >= 0x0591 && cp <= 0x05bd) || (cp >= 0x064b && cp <= 0x065f) ||
        (cp >= 0x1ab0 && cp <= 0x1aff) || (cp >= 0x1dc0 && cp <= 0x1dff) || (cp >= 0x20d0 && cp <= 0x20ff) ||
        (cp >= 0xfe20 && cp <= 0xfe2f)
}

fn is_ascii(text: String) bool {
    each text as b {
        if b >= 0x80 : return false
    }
    return true
}

/// Math signs, arrows and other symbols that are drawn centered on their own: not letters,
/// digits or punctuation that sits on the baseline.
fn is_symbol(cp: u32) bool {
    if cp < 0x80 : return cp == '+' || cp == '-' || cp == '=' || cp == '<' || cp == '>' || cp == '*' || cp == '~' || cp == '|'
    return cp == 0xd7 || cp == 0xf7 || cp == 0xb1 || cp == 0xb7 || (cp >= 0x2190 && cp < 0x2c00)
}

/// The code point at byte `i` and its length in bytes.
fn decode_utf8(text: String, i: uint) (u32, uint) {
    let b = text[i].to(u32)
    if b < 0x80 : return (b, 1)
    let len: uint = b >= 0xf0 ? 4 : (b >= 0xe0 ? 3 : 2)
    if i + len > text.length : return (0xfffd, 1)
    let cp = b & (len == 2 ? 0x1f : (len == 3 ? 0x0f : 0x07))
    each 1 .. len - 1 as k : cp = (cp << 6) | (text[i + k].to(u32) & 0x3f)
    return (cp, len)
}

fn font_key(font: ResolvedFont, size_key: u64) u64 {
    return font.name.hash().to(u64) * 31 + font.weight.to(u64) * 100003 + (font.italic ? 7919 : 0) + size_key
}

fn builtin_font(weight: FontWeight, italic: bool) String {
    if italic : return #embed("assets/fonts/Inter-Italic.ttf")
    return match weight : String {
        .normal => #embed("assets/fonts/Inter-Regular.ttf")
        .medium => #embed("assets/fonts/Inter-Medium.ttf")
        .semibold => #embed("assets/fonts/Inter-SemiBold.ttf")
        .bold => #embed("assets/fonts/Inter-Bold.ttf")
    }
}
