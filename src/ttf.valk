// Pure Valk TrueType (.ttf / .ttc) parser and analytical anti-aliased glyph rasterizer.

struct TtfPoint {
    x: f32
    y: f32
    on_curve: bool
}

struct TtfEdge {
    x0: f32
    y0: f32
    x1: f32
    y1: f32
}

class RasterGlyph {
    width: i32 (0)
    height: i32 (0)
    offset_x: i32 (0)
    offset_y: i32 (0)
    advance: f32 (0)
    bitmap: mut &[u8] ([u8]{})
    valid: bool (false)
}

class TtfFont {
    data: String
    units_per_em: f32 (1000)
    ascent: i32 (800)
    descent: i32 (-200)
    num_glyphs: u32 (0)
    num_hmetrics: u32 (0)
    loca_long: bool (false)
    loca_off: uint (0)
    glyf_off: uint (0)
    glyf_len: uint (0)
    hmtx_off: uint (0)
    cmap_sub: uint (0)
    cmap_fmt: u32 (0)
    valid: bool (false)

    static fn parse(raw: String) TtfFont {
        let data = ttc_first_font(raw)
        let f = TtfFont{ data: data }
        if data.length < 12 : return f
        let sig = ttf_u32(data, 0)
        // Accept TrueType (0x00010000 or 'true')
        if sig != 0x00010000 && sig != 0x74727565 : return f
        let num_tables = ttf_u16(data, 4).to(uint)
        let head_off: uint = 0
        let hhea_off: uint = 0
        let maxp_off: uint = 0
        let cmap_off: uint = 0
        let i: uint = 0
        while i < num_tables {
            let rec = 12 + i * 16
            if rec + 16 > data.length : break
            let tag = data.range(rec, 4)
            let off = ttf_u32(data, rec + 8).to(uint)
            let len = ttf_u32(data, rec + 12).to(uint)
            if off + len <= data.length {
                if tag == "head" : head_off = off
                else if tag == "hhea" : hhea_off = off
                else if tag == "maxp" : maxp_off = off
                else if tag == "hmtx" : f.hmtx_off = off
                else if tag == "loca" : f.loca_off = off
                else if tag == "glyf" { f.glyf_off = off; f.glyf_len = len }
                else if tag == "cmap" : cmap_off = off
            }
            i++
        }
        if head_off == 0 || hhea_off == 0 || maxp_off == 0 || f.hmtx_off == 0 || f.loca_off == 0 || f.glyf_off == 0 || cmap_off == 0 : return f
        if head_off + 54 > data.length || hhea_off + 36 > data.length || maxp_off + 6 > data.length : return f

        f.units_per_em = ttf_u16(data, head_off + 18).to(f32)
        f.loca_long = ttf_u16(data, head_off + 50) != 0
        f.ascent = ttf_i16(data, hhea_off + 4)
        f.descent = ttf_i16(data, hhea_off + 6)
        f.num_hmetrics = ttf_u16(data, hhea_off + 34)
        f.num_glyphs = ttf_u16(data, maxp_off + 4)
        if f.units_per_em <= 0 || f.ascent - f.descent <= 0 : return f

        // Pick best cmap subtable: prefer format 12 (full Unicode), then format 4 (BMP)
        if cmap_off + 4 > data.length : return f
        let sub_count = ttf_u16(data, cmap_off + 2).to(uint)
        let best_off: uint = 0
        let best_fmt: u32 = 0
        let best_prio: int = -1
        let s: uint = 0
        while s < sub_count {
            let rec = cmap_off + 4 + s * 8
            if rec + 8 > data.length : break
            let plat = ttf_u16(data, rec)
            let enc = ttf_u16(data, rec + 2)
            let sub = cmap_off + ttf_u32(data, rec + 4).to(uint)
            if sub + 4 > data.length { s++; continue }
            let fmt = ttf_u16(data, sub)
            let prio: int = -1
            if fmt == 12 && (plat == 3 || plat == 0) : prio = 4
            else if fmt == 4 && plat == 3 && enc == 1 : prio = 3
            else if fmt == 4 && plat == 0 : prio = 2
            else if fmt == 4 : prio = 1
            if prio > best_prio {
                best_prio = prio
                best_off = sub
                best_fmt = fmt
            }
            s++
        }
        if best_off == 0 : return f
        f.cmap_sub = best_off
        f.cmap_fmt = best_fmt
        f.valid = true
        return f
    }

    fn glyph_index(cp: u32) u32 {
        if !this.valid : return 0
        let d = this.data
        let sub = this.cmap_sub
        if this.cmap_fmt == 12 {
            if sub + 16 > d.length : return 0
            let n = ttf_u32(d, sub + 12).to(uint)
            let lo: uint = 0
            let hi = n
            while lo < hi {
                let mid = (lo + hi) / 2
                let rec = sub + 16 + mid * 12
                if rec + 12 > d.length : return 0
                let start = ttf_u32(d, rec)
                let end_c = ttf_u32(d, rec + 4)
                if cp < start {
                    hi = mid
                } else if cp > end_c {
                    lo = mid + 1
                } else {
                    let start_gid = ttf_u32(d, rec + 8)
                    return start_gid + (cp - start)
                }
            }
            return 0
        }
        if this.cmap_fmt == 4 {
            if cp > 0xffff || sub + 14 > d.length : return 0
            let seg_count = (ttf_u16(d, sub + 6) / 2).to(uint)
            let end_base = sub + 14
            let start_base = end_base + seg_count * 2 + 2
            let delta_base = start_base + seg_count * 2
            let range_base = delta_base + seg_count * 2
            if range_base + seg_count * 2 > d.length : return 0
            let lo: uint = 0
            let hi = seg_count
            while lo < hi {
                let mid = (lo + hi) / 2
                let end_c = ttf_u16(d, end_base + mid * 2)
                if cp > end_c {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            if lo >= seg_count : return 0
            let start_c = ttf_u16(d, start_base + lo * 2)
            if cp < start_c : return 0
            let range_off_pos = range_base + lo * 2
            let range_off = ttf_u16(d, range_off_pos).to(uint)
            let delta = ttf_i16(d, delta_base + lo * 2)
            if range_off == 0 {
                return ((cp.to(int) + delta) & 0xffff).to(u32)
            }
            let glyph_pos = range_off_pos + range_off + (cp - start_c).to(uint) * 2
            if glyph_pos + 2 > d.length : return 0
            let gid = ttf_u16(d, glyph_pos)
            if gid == 0 : return 0
            return ((gid.to(int) + delta) & 0xffff).to(u32)
        }
        return 0
    }

    fn has_codepoint(cp: u32) bool {
        if cp == 32 : return true
        return this.glyph_index(cp) != 0
    }

    fn scale_for_pixel_height(px: f32) f32 {
        return px / (this.ascent - this.descent).to(f32)
    }

    fn advance_width(gid: u32) i32 {
        if !this.valid || this.num_hmetrics == 0 : return 0
        let idx = gid < this.num_hmetrics ? gid : this.num_hmetrics - 1
        let off = this.hmtx_off + idx.to(uint) * 4
        if off + 2 > this.data.length : return 0
        return ttf_u16(this.data, off).to(i32)
    }

    - fn glyph_offset(gid: u32) (uint, uint) {
        if gid >= this.num_glyphs : return (0, 0)
        let d = this.data
        let g = gid.to(uint)
        let o0: uint = 0
        let o1: uint = 0
        if this.loca_long {
            let p = this.loca_off + g * 4
            if p + 8 > d.length : return (0, 0)
            o0 = ttf_u32(d, p).to(uint)
            o1 = ttf_u32(d, p + 4).to(uint)
        } else {
            let p = this.loca_off + g * 2
            if p + 4 > d.length : return (0, 0)
            o0 = ttf_u16(d, p).to(uint) * 2
            o1 = ttf_u16(d, p + 2).to(uint) * 2
        }
        if o1 <= o0 || o1 > this.glyf_len : return (0, 0)
        return (this.glyf_off + o0, this.glyf_off + o1)
    }

    fn rasterize(cp: u32, px: f32) RasterGlyph {
        let out = RasterGlyph{}
        if !this.valid : return out
        let gid = this.glyph_index(cp)
        let scale = this.scale_for_pixel_height(px)
        out.advance = this.advance_width(gid).to(f32) * scale
        out.valid = gid != 0 || cp == 32

        let edges = Array[TtfEdge]{}
        this.collect_edges(gid, scale, 1, 0, 0, 1, 0, 0, edges, 0)
        if edges.length == 0 : return out

        let min_x: f32 = 1e9
        let max_x: f32 = -1e9
        let min_y: f32 = 1e9
        let max_y: f32 = -1e9
        each edges as e {
            if e.x0 < min_x : min_x = e.x0
            if e.x1 < min_x : min_x = e.x1
            if e.x0 > max_x : max_x = e.x0
            if e.x1 > max_x : max_x = e.x1
            if e.y0 < min_y : min_y = e.y0
            if e.y1 < min_y : min_y = e.y1
            if e.y0 > max_y : max_y = e.y0
            if e.y1 > max_y : max_y = e.y1
        }
        let ix0 = floor32(min_x).to(i32)
        let iy0 = floor32(min_y).to(i32)
        let ix1 = ceil32(max_x).to(i32)
        let iy1 = ceil32(max_y).to(i32)
        let w = (ix1 - ix0).max(0)
        let h = (iy1 - iy0).max(0)
        if w <= 0 || h <= 0 || w > 512 || h > 512 : return out

        // Rasterize edges into pixel coverage buffers (y=0 is top of ascent line)
        let uw = w.to(uint)
        let uh = h.to(uint)
        let stride = uw + 1
        let area = [f32]{ 0.0 x (uw * uh) }
        let cover = [f32]{ 0.0 x (stride * uh) }
        let fx0 = ix0.to(f32)
        let fy0 = iy0.to(f32)

        each edges as e {
            rasterize_edge(e.x0 - fx0, e.y0 - fy0, e.x1 - fx0, e.y1 - fy0, w, h, area, cover)
        }

        let bitmap = [u8]{ 0 x (uw * uh) }
        let row: uint = 0
        while row < uh {
            let acc: f32 = 0
            let col: uint = 0
            let r_area = row * uw
            let r_cov = row * stride
            while col < uw {
                acc += cover[r_cov + col]
                let v = (acc + area[r_area + col]).abs()
                if v > 1.0 : v = 1.0
                bitmap[r_area + col] = (v * 255.0 + 0.5).to(u8)
                col++
            }
            row++
        }

        out.width = w
        out.height = h
        out.offset_x = ix0
        out.offset_y = iy0 + round32(this.ascent.to(f32) * scale).to(i32)
        out.bitmap = bitmap
        return out
    }

    - fn collect_edges(gid: u32, scale: f32, m00: f32, m01: f32, m10: f32, m11: f32, tx: f32, ty: f32, out: Array[TtfEdge], depth: int) {
        if depth > 8 : return
        let g_start, g_end = this.glyph_offset(gid)
        if g_end <= g_start || g_start + 10 > g_end : return
        let d = this.data
        let num_contours = ttf_i16(d, g_start)

        if num_contours > 0 {
            let nc = num_contours.to(uint)
            if g_start + 10 + nc * 2 + 2 > g_end : return
            let ends = Array[uint]{}
            let max_pt: uint = 0
            let c: uint = 0
            while c < nc {
                let ep = ttf_u16(d, g_start + 10 + c * 2).to(uint)
                ends.append(ep)
                if ep > max_pt : max_pt = ep
                c++
            }
            let num_pts = max_pt + 1
            let ins_off = g_start + 10 + nc * 2
            let ins_len = ttf_u16(d, ins_off).to(uint)
            let p = ins_off + 2 + ins_len
            if p > g_end : return

            let flags = Array[u8]{}
            while flags.length < num_pts && p < g_end {
                let fl = d[p]
                p++
                flags.append(fl)
                if (fl & 8) != 0 && p < g_end {
                    let rep = d[p].to(uint)
                    p++
                    let r: uint = 0
                    while r < rep && flags.length < num_pts {
                        flags.append(fl)
                        r++
                    }
                }
            }
            if flags.length < num_pts : return

            let xs = Array[i32]{}
            let cx: i32 = 0
            let i: uint = 0
            while i < num_pts {
                let fl = flags.get(i) !? 0
                if (fl & 2) != 0 {
                    if p >= g_end : return
                    let dx = d[p].to(i32)
                    p++
                    cx += (fl & 16) != 0 ? dx : -dx
                } else if (fl & 16) == 0 {
                    if p + 2 > g_end : return
                    cx += ttf_i16(d, p)
                    p += 2
                }
                xs.append(cx)
                i++
            }

            let ys = Array[i32]{}
            let cy: i32 = 0
            i = 0
            while i < num_pts {
                let fl = flags.get(i) !? 0
                if (fl & 4) != 0 {
                    if p >= g_end : return
                    let dy = d[p].to(i32)
                    p++
                    cy += (fl & 32) != 0 ? dy : -dy
                } else if (fl & 32) == 0 {
                    if p + 2 > g_end : return
                    cy += ttf_i16(d, p)
                    p += 2
                }
                ys.append(cy)
                i++
            }

            // Build transformed points and flatten each contour
            let pts = Array[TtfPoint]{}
            i = 0
            while i < num_pts {
                let fx = (xs.get(i) !? 0).to(f32)
                let fy = (ys.get(i) !? 0).to(f32)
                let gx = (m00 * fx + m01 * fy + tx) * scale
                // TrueType Y goes up; screen Y goes down
                let gy = -(m10 * fx + m11 * fy + ty) * scale
                let on_c = ((flags.get(i) !? 0) & 1) != 0
                pts.append(.{ x: gx, y: gy, on_curve: on_c })
                i++
            }

            let start_pt: uint = 0
            each ends as end_pt {
                if end_pt >= start_pt && end_pt < pts.length {
                    flatten_contour(pts, start_pt, end_pt, out)
                }
                start_pt = end_pt + 1
            }
            return
        }

        if num_contours < 0 {
            // Compound glyph
            let p = g_start + 10
            let more = true
            while more && p + 4 <= g_end {
                let fl = ttf_u16(d, p)
                let comp_gid = ttf_u16(d, p + 2)
                p += 4
                let arg1: i32 = 0
                let arg2: i32 = 0
                if (fl & 1) != 0 {
                    if p + 4 > g_end : break
                    arg1 = ttf_i16(d, p)
                    arg2 = ttf_i16(d, p + 2)
                    p += 4
                } else {
                    if p + 2 > g_end : break
                    arg1 = ttf_i8(d[p])
                    arg2 = ttf_i8(d[p + 1])
                    p += 2
                }
                let a: f32 = 1
                let b: f32 = 0
                let c: f32 = 0
                let e: f32 = 1
                if (fl & 8) != 0 {
                    if p + 2 > g_end : break
                    let s = ttf_i16(d, p).to(f32) / 16384.0
                    a = s; e = s
                    p += 2
                } else if (fl & 64) != 0 {
                    if p + 4 > g_end : break
                    a = ttf_i16(d, p).to(f32) / 16384.0
                    e = ttf_i16(d, p + 2).to(f32) / 16384.0
                    p += 4
                } else if (fl & 128) != 0 {
                    if p + 8 > g_end : break
                    a = ttf_i16(d, p).to(f32) / 16384.0
                    c = ttf_i16(d, p + 2).to(f32) / 16384.0
                    b = ttf_i16(d, p + 4).to(f32) / 16384.0
                    e = ttf_i16(d, p + 6).to(f32) / 16384.0
                    p += 8
                }
                let dx: f32 = (fl & 2) != 0 ? arg1.to(f32) : 0
                let dy: f32 = (fl & 2) != 0 ? arg2.to(f32) : 0
                let nm00 = m00 * a + m01 * c
                let nm01 = m00 * b + m01 * e
                let nm10 = m10 * a + m11 * c
                let nm11 = m10 * b + m11 * e
                let ntx = m00 * dx + m01 * dy + tx
                let nty = m10 * dx + m11 * dy + ty
                this.collect_edges(comp_gid, scale, nm00, nm01, nm10, nm11, ntx, nty, out, depth + 1)
                more = (fl & 32) != 0
            }
        }
    }
}

fn flatten_contour(pts: Array[TtfPoint], start: uint, end_pt: uint, out: Array[TtfEdge]) {
    let count = end_pt - start + 1
    if count < 2 : return
    let first = pts.get(start) !? TtfPoint{ x: 0, y: 0, on_curve: true }
    let last = pts.get(end_pt) !? first

    let cur_x: f32 = 0
    let cur_y: f32 = 0
    let idx: uint = 0
    if first.on_curve {
        cur_x = first.x
        cur_y = first.y
        idx = 1
    } else if last.on_curve {
        cur_x = last.x
        cur_y = last.y
        idx = 0
    } else {
        cur_x = (first.x + last.x) * 0.5
        cur_y = (first.y + last.y) * 0.5
        idx = 0
    }
    let start_x = cur_x
    let start_y = cur_y

    let has_ctrl = false
    let ctrl_x: f32 = 0
    let ctrl_y: f32 = 0

    let k = idx
    while k < count {
        let pt = pts.get(start + k) !? first
        if pt.on_curve {
            if has_ctrl {
                flatten_quad(cur_x, cur_y, ctrl_x, ctrl_y, pt.x, pt.y, out, 0)
                has_ctrl = false
            } else {
                add_edge(cur_x, cur_y, pt.x, pt.y, out)
            }
            cur_x = pt.x
            cur_y = pt.y
        } else {
            if has_ctrl {
                let mx = (ctrl_x + pt.x) * 0.5
                let my = (ctrl_y + pt.y) * 0.5
                flatten_quad(cur_x, cur_y, ctrl_x, ctrl_y, mx, my, out, 0)
                cur_x = mx
                cur_y = my
            }
            ctrl_x = pt.x
            ctrl_y = pt.y
            has_ctrl = true
        }
        k++
    }
    // Close contour back to start
    if has_ctrl {
        flatten_quad(cur_x, cur_y, ctrl_x, ctrl_y, start_x, start_y, out, 0)
    } else {
        add_edge(cur_x, cur_y, start_x, start_y, out)
    }
}

fn flatten_quad(x0: f32, y0: f32, cx: f32, cy: f32, x1: f32, y1: f32, out: Array[TtfEdge], depth: int) {
    let dx = (x0 - 2.0 * cx + x1).abs()
    let dy = (y0 - 2.0 * cy + y1).abs()
    if depth >= 6 || dx + dy < 0.35 {
        add_edge(x0, y0, x1, y1, out)
        return
    }
    let ax = (x0 + cx) * 0.5
    let ay = (y0 + cy) * 0.5
    let bx = (cx + x1) * 0.5
    let by = (cy + y1) * 0.5
    let mx = (ax + bx) * 0.5
    let my = (ay + by) * 0.5
    flatten_quad(x0, y0, ax, ay, mx, my, out, depth + 1)
    flatten_quad(mx, my, bx, by, x1, y1, out, depth + 1)
}

fn add_edge(x0: f32, y0: f32, x1: f32, y1: f32, out: Array[TtfEdge]) {
    if (y0 - y1).abs() < 0.00001 : return
    out.append(.{ x0: x0, y0: y0, x1: x1, y1: y1 })
}

// Exact analytical signed-area trapezoid integration for one edge across scanlines.
fn rasterize_edge(ex0: f32, ey0: f32, ex1: f32, ey1: f32, w: i32, h: i32, area: local mut &[f32], cover: local mut &[f32]) {
    let dir: f32 = 1.0
    let x0 = ex0
    let y0 = ey0
    let x1 = ex1
    let y1 = ey1
    if y0 > y1 {
        dir = -1.0
        let tx = x0; x0 = x1; x1 = tx
        let ty = y0; y0 = y1; y1 = ty
    }
    if y1 <= 0 || y0 >= h.to(f32) : return
    let dy_total = y1 - y0
    if dy_total < 0.00001 : return
    let dx_dy = (x1 - x0) / dy_total

    let iy_start = floor32(y0).to(i32).max(0)
    let iy_end = ceil32(y1).to(i32).min(h)
    let uw = w.to(uint)
    let stride = uw + 1

    let iy = iy_start
    while iy < iy_end {
        let fy = iy.to(f32)
        let ya = y0 > fy ? y0 : fy
        let yb = y1 < fy + 1.0 ? y1 : fy + 1.0
        let dy = yb - ya
        if dy <= 0.000001 { iy++; continue }

        let xa = x0 + (ya - y0) * dx_dy
        let xb = x0 + (yb - y0) * dx_dy
        let xl = xa < xb ? xa : xb
        let xr = xa < xb ? xb : xa

        let r_area = iy.to(uint) * uw
        let r_cov = iy.to(uint) * stride

        if xr <= 0.0 {
            cover[r_cov] += dy * dir
            iy++
            continue
        }
        if xl >= w.to(f32) {
            iy++
            continue
        }

        let ix0 = floor32(xl).to(i32)
        let ix1 = floor32(xr).to(i32)
        if ix0 == ix1 {
            if ix0 >= 0 && ix0 < w {
                let uix = ix0.to(uint)
                let mid_x = (xl + xr) * 0.5
                area[r_area + uix] += ((ix0 + 1).to(f32) - mid_x) * dy * dir
                cover[r_cov + uix + 1] += dy * dir
            } else if ix0 < 0 {
                cover[r_cov] += dy * dir
            }
        } else {
            let span_x = xr - xl
            let dy_dx = dy / span_x
            let ix = ix0
            while ix <= ix1 {
                let px0 = ix.to(f32)
                let px1 = px0 + 1.0
                let sx0 = xl > px0 ? xl : px0
                let sx1 = xr < px1 ? xr : px1
                let seg_w = sx1 - sx0
                if seg_w > 0.0 {
                    let seg_dy = seg_w * dy_dx
                    if ix < 0 {
                        cover[r_cov] += seg_dy * dir
                    } else if ix < w {
                        let uix = ix.to(uint)
                        let mid = (sx0 + sx1) * 0.5
                        area[r_area + uix] += (px1 - mid) * seg_dy * dir
                        cover[r_cov + uix + 1] += seg_dy * dir
                    }
                }
                ix++
            }
        }
        iy++
    }
}

fn ttf_u32(d: String, at: uint) u32 {
    return (d[at].to(u32) << 24) | (d[at + 1].to(u32) << 16) | (d[at + 2].to(u32) << 8) | d[at + 3].to(u32)
}

fn ttf_u16(d: String, at: uint) u32 {
    return (d[at].to(u32) << 8) | d[at + 1].to(u32)
}

fn ttf_i16(d: String, at: uint) i32 {
    let v = ttf_u16(d, at).to(i32)
    return v >= 0x8000 ? v - 0x10000 : v
}

fn ttf_i8(b: u8) i32 {
    let v = b.to(i32)
    return v >= 128 ? v - 256 : v
}
