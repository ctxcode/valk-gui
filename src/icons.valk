        .zoom_out => { ring(10.5, 10.5, 6); line(15, 15, 20, 20); line(7.5, 10.5, 13.5, 10.5) }
        // ---- Media & audio ----
        .stop => box(6, 6, 12, 12, 1.5)
        .skip_back => { line(5, 6, 5, 18); p.triangle(pt(18, 6), pt(8, 12), pt(18, 18), color) }
        .skip_forward => { line(19, 6, 19, 18); p.triangle(pt(6, 6), pt(16, 12), pt(6, 18), color) }
        .rewind => { p.triangle(pt(11, 6), pt(4, 12), pt(11, 18), color); p.triangle(pt(19, 6), pt(12, 12), pt(19, 18), color) }
        .fast_forward => { p.triangle(pt(5, 6), pt(12, 12), pt(5, 18), color); p.triangle(pt(13, 6), pt(20, 12), pt(13, 18), color) }
        .volume => {
