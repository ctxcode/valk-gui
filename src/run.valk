use raylib
use valk.core
use valk.fs

/// Opens a window, shows `root` in it and handles input until the window closes. Throws when the
/// system can't open a window, for example without OpenGL 3.3.
+ fn run(root: Render, options: WindowOptions (WindowOptions{})) !InitError {
    let flags: u32 = raylib.FLAG_WINDOW_HIGHDPI
    if options.resizable : flags = flags | raylib.FLAG_WINDOW_RESIZABLE
    if options.antialias : flags = flags | raylib.FLAG_MSAA_4X_HINT
    if options.hidden || isset(env_hidden()) : flags = flags | raylib.FLAG_WINDOW_HIDDEN
    else : flags = flags | raylib.FLAG_VSYNC_HINT
    raylib.set_trace_log_level(.error)
    raylib.set_config_flags(flags)
    raylib.init_window(options.width, options.height, options.title)
    if !raylib.is_window_ready() : throw .init
    apply_window_icon(options)
    raylib.set_window_min_size(options.min_width, options.min_height)
    raylib.set_exit_key(.none)
    raylib.set_target_fps(60)

    let fonts = Fonts.new(options.fallback_fonts)
    let platform = RaylibPlatform{ fonts: fonts }
    let sdf = Sdf.load()
    let win = Window.new(root, raylib.get_screen_width().to(f32), raylib.get_screen_height().to(f32), platform, options.theme)
    win.title = options.title
    each options.fonts as f : win.fonts.append(f)
    fonts.window = win

    let shot: ?String = options.screenshot.length > 0 ? options.screenshot : env_screenshot()
    let shot_after = (core.getenv("VALK_GUI_SCREENSHOT_AFTER") !? "0").to(f64) !? 0
    let input = RaylibInput{}
    let first = true
    while !raylib.window_should_close() && !win.quit_requested {
        win.time = raylib.get_time()
        let changed = first || isset(shot)
        first = false
        if raylib.is_window_resized() {
            win.resize(raylib.get_screen_width().to(f32), raylib.get_screen_height().to(f32))
            changed = true
        }
        if input.poll(win) : changed = true
        if win.tick() : changed = true
        if win.title_changed {
            raylib.set_window_title(win.title)
            win.title_changed = false
        }
        if !changed && !win.frame_requested && !win.dirty {
            // Nothing to draw: sleep until input, or until the next timer when one is pending
            if win.busy() {
                raylib.disable_event_waiting()
                raylib.wait_time((win.next_due() - win.time).max(0.001).min(1.0 / 60.0))
            } else {
                raylib.enable_event_waiting()
            }
            raylib.poll_input_events()
            continue
        }
        win.frame_requested = false
        win.draw()
        input.set_cursor(win.cursor)

        raylib.begin_drawing()
        raylib.clear_background(to_rl(win.theme.background))
        draw_scene(win, platform, sdf)
        if isset(shot) && win.frames >= 3 && win.time >= shot_after {
            // Ending the scissor mode draws what is batched, before the buffers swap
            raylib.end_scissor_mode()
            let image = raylib.load_image_from_screen()
            raylib.export_image(image, shot)
            raylib.unload_image(image)
            raylib.end_drawing()
            break
        }
        // Drawing ends by reading input; without anything pending it waits for some
        if win.busy() || isset(shot) {
            raylib.disable_event_waiting()
        } else {
            raylib.enable_event_waiting()
        }
        raylib.end_drawing()
    }
    sdf.unload()
    fonts.unload()
    platform.unload()
    raylib.close_window()
}

// Sets the window icon from `options.icon` (file path) or `options.icon_png` (embedded PNG bytes).
fn apply_window_icon(options: WindowOptions) {
    if options.icon.length > 0 && fs.is_file(options.icon) {
        let img = raylib.load_image(options.icon)
        if raylib.is_image_valid(img) {
            raylib.set_window_icon(img)
            raylib.unload_image(img)
        }
        return
    }
    if options.icon_png.length > 0 {
        let tmp = fs.create_temp_file("valk-gui-icon-", ".png") ! return
        defer { fs.delete_file(tmp) _ }
        fs.write(tmp, options.icon_png) ! return
        let img = raylib.load_image(tmp)
        if raylib.is_image_valid(img) {
            raylib.set_window_icon(img)
            raylib.unload_image(img)
        }
    }
}

// VALK_GUI_SCREENSHOT=file.png saves the third frame and exits; for tests and docs
fn env_screenshot() ?String {
    let value = core.getenv("VALK_GUI_SCREENSHOT") ! return null
    if value == "" : return null
    return value
}
fn env_hidden() ?String {
    let value = core.getenv("VALK_GUI_HIDDEN") ! return null
    if value == "" : return null
    return value
}

class RaylibPlatform is Platform {
    fonts: Fonts
    textures: Map[raylib.Texture] (.{})

    fn text_width(text: String, font: ResolvedFont) f32 { return this.fonts.width(text, font) }

    fn image_size(path: String) Point {
        let t = this.texture(path)
        return .{ x: t.width.to(f32), y: t.height.to(f32) }
    }

    fn clipboard() String { return raylib.get_clipboard_text() }
    fn set_clipboard(text: String) { raylib.set_clipboard_text(text) }

    fn texture(path: String) raylib.Texture {
        let cached = this.textures.get(path) ! {
            let t = raylib.load_texture(path)
            if t.id != 0 {
                t.gen_mipmaps()
                raylib.set_texture_filter(t, .trilinear)
            }
            this.textures.set(path, t)
            return t
        }
        return cached
    }

    fn unload() {
        each this.textures as t : raylib.unload_texture(t)
    }
}

class RaylibInput {
    last_x: f32 (-1)
    last_y: f32 (-1)
    last_mods: Modifiers (.{})
    cursor: Cursor (.default)

    /// Hands the window the input since the last poll. True when there was any.
    fn poll(win: Window) bool {
        let any = false
        let mods = modifiers()
        let pos = raylib.get_mouse_position()
        let x = pos.x
        let y = pos.y
        if !raylib.is_cursor_on_screen() && !raylib.is_mouse_button_down(.left) {
            x = -1
            y = -1
        }
        if x != this.last_x || y != this.last_y {
            this.last_x = x
            this.last_y = y
            win.mouse_move(x, y, mods)
            any = true
        }
        each Array[MouseButton]{ .left, .right, .middle } as button {
            let rb = to_rl_button(button)
            if raylib.is_mouse_button_pressed(rb) {
                win.mouse_down(x, y, button, mods)
                any = true
            }
            if raylib.is_mouse_button_released(rb) {
                win.mouse_up(x, y, button, mods)
                any = true
            }
        }
        let wheel = raylib.get_mouse_wheel_move_v()
        if wheel.x != 0 || wheel.y != 0 {
            let dx = -wheel.x * 40
            let dy = -wheel.y * 40
            if mods.shift && dx == 0 {
                dx = dy
                dy = 0
            }
            win.scroll(dx, dy, mods)
            any = true
        }
        while true {
            let code = raylib.get_key_pressed()
            if code == 0 : break
            any = true
            let key = key_from_code(code)
            if key != .unknown : win.key_down(key, mods)
        }
        each Array[raylib.KeyboardKey]{ .backspace, .delete, .left, .right, .up, .down, .page_up, .page_down, .enter, .tab, .z, .y } as rk {
            if raylib.is_key_pressed_repeat(rk) {
                win.key_down(key_from_code(rk.to(i32)), mods, true)
                any = true
            }
        }
        let typed = ""
        while true {
            let cp = raylib.get_char_pressed()
            if cp <= 0 : break
            typed += codepoint_text(cp.to(u32))
        }
        if typed.length > 0 {
            win.input(typed)
            any = true
        }
        // Modifier changes alone, such as Shift for a drag, also need a frame
        if mods.shift != this.last_mods.shift || mods.ctrl != this.last_mods.ctrl || mods.alt != this.last_mods.alt || mods.cmd != this.last_mods.cmd {
            this.last_mods = mods
            any = true
        }
        if raylib.is_file_dropped() {
            win.drop_files(dropped_files())
            any = true
        }
        return any
    }

    fn set_cursor(cursor: Cursor) {
        if cursor == this.cursor : return
        this.cursor = cursor
        raylib.set_mouse_cursor(match cursor : raylib.MouseCursor {
            .default => .default
            .pointer => .pointing_hand
            .text => .ibeam
            .crosshair => .crosshair
            .not_allowed => .not_allowed
            .resize_ew => .resize_ew
            .resize_ns => .resize_ns
            .move => .resize_all
        })
    }
}

fn modifiers() Modifiers {
    return .{
        shift: raylib.is_key_down(.left_shift) || raylib.is_key_down(.right_shift),
        ctrl: raylib.is_key_down(.left_control) || raylib.is_key_down(.right_control),
        alt: raylib.is_key_down(.left_alt) || raylib.is_key_down(.right_alt),
        cmd: raylib.is_key_down(.left_super) || raylib.is_key_down(.right_super)
    }
}

fn to_rl_button(b: MouseButton) raylib.MouseButton {
    return match b : raylib.MouseButton {
        .left => .left
        .right => .right
        .middle => .middle
    }
}

/// The key for a raylib (GLFW) key code.
fn key_from_code(code: i32) Key {
    let items = Key.items()
    if code >= 65 && code <= 90 : return items.get((code - 64).to(uint)) !? .unknown
    if code >= 48 && code <= 57 : return items.get((code - 48 + 27).to(uint)) !? .unknown
    if code >= 290 && code <= 301 : return items.get((code - 290).to(uint) + Key.f1.to(uint)) !? .unknown
    return match code : Key {
        32 => .space
        256 => .escape
        257, 335 => .enter
        258 => .tab
        259 => .backspace
        260 => .insert
        261 => .delete
        262 => .right
        263 => .left
        264 => .down
        265 => .up
        266 => .page_up
        267 => .page_down
        268 => .home
        269 => .end
        45 => .minus
        61 => .equal
        44 => .comma
        46 => .period
        47 => .slash
        59 => .semicolon
        39 => .apostrophe
        91 => .left_bracket
        92 => .backslash
        93 => .right_bracket
        96 => .grave
        default => .unknown
    }
}


fn dropped_files() Array[String] {
    let list = raylib.load_dropped_files()
    let result = Array[String]{}
    let paths = list.paths
    if isset(paths) {
        let items = paths.@cast(*[?cstring])
        each 0 .. list.count.to(uint) as i {
            @unsafe
            let p = items[i]
            if isset(p) : result.append(p.to_string())
        }
    }
    raylib.unload_dropped_files(list)
    return result
}
