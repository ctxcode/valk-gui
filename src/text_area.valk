
// One row on screen: a whole line, or a part of one when lines wrap
struct VisualRow {
    line: uint
    start: uint
    len: uint
}

struct Snapshot {
    text: String
    row: uint
    col: uint
}

struct TextMatch {
    + row: uint
    + col: uint
    + len: uint
}

/// A multi-line text editor: selection with the mouse and Shift, word jumps, copy, cut and paste,
/// undo and redo, auto-indent, Tab and Shift+Tab, find & replace, and scrolling. Keep it with
/// your state and put `area.render(win)` in the tree; give it a height or `flex_1`.
+ class TextArea is Render {
    + placeholder: String ("")
    /// Called after every edit with the new text.
    + on_change: ?fn(String)() (null)
    /// Allows selecting and copying, but not editing.
    + read_only: bool (false)
    /// Disables all interaction.
    + disabled: bool (false)
    + line_numbers: bool (false)
    /// A font family added with `Window.add_font`, such as a monospaced one for code.
    + font: String ("")
    /// The text size; the theme's when unset.
    + font_size: ?f32 (null)
    + tab_size: uint (4)
    /// Wraps long lines at the width of the area instead of scrolling sideways.
    + wrap: bool (false)
    /// Colors per line, for syntax highlighting: called for each visible line with its text, it
    /// returns `(byte length, color)` runs.
    + highlight: ?fn(String)(Array[(uint, Color)]) (null)
    /// Find & replace state.
    + find_open: bool (false)
    + replace_open: bool (false)
    + case_sensitive: bool (false)
    + find_input: TextInput (TextInput.new("Find…"))
    + replace_input: TextInput (TextInput.new("Replace…"))
    ~+ current_match: uint (0)
    /// The caret: a line and a byte offset in it.
    ~+ row: uint (0)
    ~+ col: uint (0)
    /// The other end of the selection.
    ~+ anchor_row: uint (0)
    ~+ anchor_col: uint (0)
    ~+ lines: Array[String] (.{ "" })
    handle: ?FocusHandle (null)
    scroll_x: f32 (0)
    scroll_y: f32 (0)
    goal_x: f32 (-1)
    reveal: bool (false)
    view: Bounds (.{})
    size: f32 (14)
    undo_stack: Array[Snapshot] (.{})
    redo_stack: Array[Snapshot] (.{})
    last_edit: String ("")
    version: uint (0)
    visual: Array[VisualRow] (.{})
    visual_version: uint (999999999)
    visual_width: f32 (-1)

    + static fn new(text: String ("")) TextArea {
        let a = TextArea{}
        a.set_text(text)
        return a
    }

    + get text: String { return this.lines.join("\n") }

    /// Replaces the text and puts the caret at the start. Clears the undo history.
    + fn set_text(text: String) {
        this.lines = text.replace("\r\n", "\n").split("\n")
        if this.lines.length == 0 : this.lines.append("")
        this.row = 0
        this.col = 0
        this.anchor_row = 0
        this.anchor_col = 0
        this.undo_stack.clear()
        this.redo_stack.clear()
        this.version++
    }

    + fn focus_handle(win: Window) FocusHandle {
        let h = this.handle
        if isset(h) : return h
        let created = win.focus_handle()
        this.handle = created
        return created
    }

    + fn has_selection() bool { return this.row != this.anchor_row || this.col != this.anchor_col }

    + fn selected_text() String {
        let r1, c1, r2, c2 = this.selection()
        if r1 == r2 : return this.line(r1).range(c1, c2 - c1)
        let parts = Array[String]{ this.line(r1).range(c1, this.line(r1).length - c1) }
        each r1 + 1 .. r2 - r1 - 1 as r : parts.append(this.line(r))
        parts.append(this.line(r2).range(0, c2))
        return parts.join("\n")
    }

    /// Moves the caret to a line (from 0) and byte offset, and scrolls it into view.
    + fn go_to(row: uint, col: uint (0)) {
        this.row = row.min(this.lines.length - 1)
        this.col = col.min(this.line(this.row).length)
        this.collapse()
        this.reveal = true
    }

    + fn select_all() {
        this.anchor_row = 0
        this.anchor_col = 0
        this.row = this.lines.length - 1
        this.col = this.line(this.row).length
    }

    /// Replaces the selection with `text`, which may have line breaks.
    + fn insert(text: String) {
        if this.read_only : return
        let clean = text.replace("\r\n", "\n").replace("\r", "\n").replace("\t", " ".repeat(this.tab_size))
        let kind = clean.length == 1 && clean != " " && clean != "\n" ? "type" : "other"
        this.remember(kind)
        this.delete_selection()
        let current = this.line(this.row)
        let before = current.range(0, this.col)
        let after = current.range(this.col, current.length - this.col)
        let parts = clean.split("\n")
        if parts.length == 1 {
            this.lines.set(this.row, before + clean + after) _
            this.col += clean.length
        } else {
            this.lines.set(this.row, before + (parts.get(0) !? "")) _
            let last = parts.get(parts.length - 1) !? ""
            each 1 .. parts.length - 2 as i : this.lines.insert(this.row + i, parts.get(i) !? "") _
            this.lines.insert(this.row + parts.length - 1, last + after) _
            this.row += parts.length - 1
            this.col = last.length
        }
        this.collapse()
        this.changed()
    }

    + fn undo() {
        let snap = this.undo_stack.pop_last() ! return
        this.redo_stack.append(this.snapshot())
        this.restore(snap)
    }

    + fn redo() {
        let snap = this.redo_stack.pop_last() ! return
        this.undo_stack.append(this.snapshot())
        this.restore(snap)
    }

    /// Opens the inline find bar.
    + fn open_find(query: String ("")) {
        this.find_open = true
        if query.length > 0 : this.find_input.set_text(query)
        else if this.has_selection() && this.row == this.anchor_row : this.find_input.set_text(this.selected_text())
    }

    /// Opens the inline find & replace bar.
    + fn open_replace(query: String ("")) {
        this.open_find(query)
        this.replace_open = true
    }

    /// Closes the inline find & replace bar.
    + fn close_find() {
        this.find_open = false
        this.replace_open = false
    }

    /// Returns all matches of `find_input.text` in the document.
    + fn find_matches() Array[TextMatch] {
        let out = Array[TextMatch]{}
        let q = this.find_input.text
        if q.length == 0 : return out
        let needle = this.case_sensitive ? q : q.lower()
        each this.lines as line, r {
            let hay = this.case_sensitive ? line : line.lower()
            let pos: uint = 0
            while pos + needle.length <= hay.length {
                if hay.range(pos, needle.length) == needle {
                    out.append(.{ row: r, col: pos, len: needle.length })
                    pos += needle.length.max(1)
                } else {
                    pos++
                }
            }
        }
        return out
    }

    /// Selects and reveals the next search match.
    + fn find_next() bool {
        let m = this.find_matches()
        if m.length == 0 : return false
        let idx: uint = 0
        let found = false
        each m as hit, i {
            if hit.row > this.row || (hit.row == this.row && hit.col >= this.col) {
                idx = i
                found = true
                break
            }
        }
        if !found : idx = 0
        this.select_match(m, idx)
        return true
    }

    /// Selects and reveals the previous search match.
    + fn find_prev() bool {
        let m = this.find_matches()
        if m.length == 0 : return false
        let idx = m.length - 1
        let i = m.length
        while i > 0 {
            i--
            let hit = m.get(i) !!
            if hit.row < this.row || (hit.row == this.row && hit.col < this.anchor_col.min(this.col)) {
                idx = i
                break
            }
        }
        this.select_match(m, idx)
        return true
    }

    - fn select_match(m: Array[TextMatch], idx: uint) {
        let hit = m.get(idx) ! return
        this.current_match = idx
        this.anchor_row = hit.row
        this.anchor_col = hit.col
        this.row = hit.row
        this.col = hit.col + hit.len
        this.reveal = true
    }

    /// Replaces the current match (if selected) and advances to the next match.
    + fn replace_current() bool {
        if this.read_only || this.find_input.text.length == 0 : return false
        let q = this.find_input.text
        let sel = this.selected_text()
        let matches_sel = this.case_sensitive ? sel == q : sel.lower() == q.lower()
        if !matches_sel {
            if !this.find_next() : return false
        }
        this.insert(this.replace_input.text)
        this.find_next()
        return true
    }

    /// Replaces all occurrences of `find_input.text` with `replace_input.text`. Returns count replaced.
    + fn replace_all() uint {
        if this.read_only : return 0
        let hits = this.find_matches()
        if hits.length == 0 : return 0
        this.remember("replace_all")
        let rep = this.replace_input.text
        let i = hits.length
        while i > 0 {
            i--
            let h = hits.get(i) !!
            let line = this.line(h.row)
            let updated = line.range(0, h.col) + rep + line.range(h.col + h.len, line.length - h.col - h.len)
            this.lines.set(h.row, updated) _
        }
        this.col = this.col.min(this.line(this.row).length)
        this.collapse()
        this.changed()
        return hits.length
    }

    + fn render(win: Window) Div {
        let theme = win.theme
        let fh = this.focus_handle(win)
        this.size = this.font_size ?? theme.font_size
        let focused = fh.is_focused()
        let editor = canvas(fn(p, b) { this.paint(win, p, b) }).flex_1().min_h(this.line_height())
            .on_mouse_down(fn(e) {
                let r, c = this.position_at(win, e.x, e.y)
                if e.click_count == 2 {
                    let text = this.line(r)
                    this.row = r
                    this.anchor_row = r
                    this.anchor_col = word_start(text, c)
                    this.col = word_end(text, c)
                } else if e.click_count >= 3 {
                    this.row = r
                    this.anchor_row = r
                    this.anchor_col = 0
                    this.col = this.line(r).length
                } else {
                    this.row = r
                    this.col = c
                    if !e.modifiers.shift : this.collapse()
                }
                this.goal_x = -1
                this.reveal = true
            })
            .on_drag(fn(e) {
                let r, c = this.position_at(win, e.x, e.y)
                this.row = r
                this.col = c
                this.reveal = true
            })
        let box = div().p(1).flex_col().bg(theme.surface).border(1).border_color(focused ? theme.accent : theme.border)
            .rounded(theme.radius).overflow_hidden().role(.textbox).aria_label(this.placeholder).disabled(this.disabled)
        if this.find_open {
            let matches = this.find_matches()
            this.find_input.on_submit = fn(q) { this.find_next() }
            let bar = div().p(6).gap(6).bg(theme.elevated).border_b(1).border_color(theme.border)
                .on_dismiss(fn() { this.close_find() })
            let row1 = div().flex().items_center().gap(6)
                .child(this.find_input.render(win).flex_1())
                .child(div().text_xs().text_color(theme.muted).whitespace_nowrap().child("%{matches.length} found"))
                .child(icon_button(win, .chevron_up, 26).tooltip("Previous match").on_click(fn(e) { this.find_prev() }))
                .child(icon_button(win, .chevron_down, 26).tooltip("Next match").on_click(fn(e) { this.find_next() }))
                .child(icon_button(win, .x, 26).tooltip("Close").on_click(fn(e) { this.close_find() }))
            bar.child(row1)
            if this.replace_open && !this.read_only {
                let row2 = div().flex().items_center().gap(6)
                    .child(this.replace_input.render(win).flex_1())
                    .child(button(win, "Replace").h(26).px(8).text_xs().on_click(fn(e) { this.replace_current() }))
                    .child(button(win, "All").h(26).px(8).text_xs().on_click(fn(e) { this.replace_all() }))
                bar.child(row2)
            }
            box.child(bar)
        }
        return box.child(div().flex().flex_1().min_h(0).cursor_text()
            .track_focus(fh)
            .on_key_down(fn(e) { this.key(win, e) })
            .on_input(fn(t) { this.insert(t) })
            .on_scroll(fn(e) {
                if this.scroll_by(win, e.dx, e.dy) : e.stop_propagation()
            })
            .child(editor))
    }

    // ---- Geometry ----

    - fn line_height() f32 { return round32(this.size * 1.5) }

    - fn resolved() ResolvedFont {
        return .{ name: this.font, size: this.size, line_height: this.line_height() }
    }

    - fn gutter(win: Window) f32 {
        if !this.line_numbers : return 8
        let digits = this.lines.length.to(String).length.max(2)
        return win.platform.text_width("0".repeat(digits), this.resolved()) + 20
    }

    - fn x_of(win: Window, r: uint, c: uint) f32 {
        let vr = this.visual_row(win, this.row_index(win, r, c))
        return this.width_of(win, r, vr.start, c)
    }

    - fn width_of(win: Window, r: uint, from: uint, to: uint) f32 {
        if to <= from : return 0
        return win.platform.text_width(this.line(r).range(from, to - from), this.resolved())
    }

    // The rows on screen, recomputed when the text or, with wrapping, the width changes
    - fn rows(win: Window) Array[VisualRow] {
        let width = this.wrap ? (this.view.w - this.gutter(win) - 8).max(20) : -1
        if this.visual_version == this.version && this.visual_width == width : return this.visual
        let rows = Array[VisualRow]{}
        each this.lines as text, r {
            if !this.wrap || text.length == 0 {
                rows.append(.{ line: r, start: 0, len: text.length })
                continue
            }
            let start: uint = 0
            while start < text.length {
                let end = this.wrap_end(win, r, start, width)
                rows.append(.{ line: r, start: start, len: end - start })
                start = end
            }
        }
        this.visual = rows
        this.visual_version = this.version
        this.visual_width = width
        return rows
    }

    // Where the row that starts at `start` ends: after the last space that fits, or at the last
    // character that fits for a word longer than the row
    - fn wrap_end(win: Window, r: uint, start: uint, width: f32) uint {
        let text = this.line(r)
        if this.width_of(win, r, start, text.length) <= width : return text.length
        let fit = next_boundary(text, start)
        let space_break: uint = 0
        let i = fit
        while i < text.length {
            let next = next_boundary(text, i)
            if this.width_of(win, r, start, next) > width : break
            fit = next
            if text[i] == ' ' : space_break = next
            i = next
        }
        return space_break > start ? space_break : fit
    }

    - fn visual_row(win: Window, index: uint) VisualRow {
        let rows = this.rows(win)
        return rows.get(index.min(rows.length - 1)) !? VisualRow{ line: 0, start: 0, len: 0 }
    }

    // The screen row that shows the caret position `r`, `c`
    - fn row_index(win: Window, r: uint, c: uint) uint {
        let rows = this.rows(win)
        let found: uint = 0
        each rows as vr, i {
            if vr.line > r : break
            if vr.line == r && vr.start <= c : found = i
        }
        return found
    }

    - fn position_at(win: Window, x: f32, y: f32) (uint, uint) {
        let lh = this.line_height()
        let rows = this.rows(win)
        let ry = y - this.view.y + this.scroll_y - 4
        let vi = ry <= 0 ? 0 : floor32(ry / lh).to(uint).min(rows.length - 1)
        let vr = this.visual_row(win, vi)
        let local = x - this.view.x - this.gutter(win) + this.scroll_x
        let text = this.line(vr.line)
        let end = vr.start + vr.len
        // A wrapped row ends before the next row's first character
        let last_row = vi + 1 >= rows.length || (rows.get(vi + 1) !? vr).line != vr.line
        let limit = last_row ? end : prev_boundary(text, end).max(vr.start)
        let best = vr.start
        let best_distance = local.abs()
        let i = vr.start
        while i < limit {
            i = next_boundary(text, i)
            let d = (this.width_of(win, vr.line, vr.start, i) - local).abs()
            if d < best_distance {
                best = i
                best_distance = d
            }
        }
        return (vr.line, best)
    }

    - fn content_height(win: Window) f32 {
        return this.rows(win).length.to(f32) * this.line_height() + 8
    }

    - fn scroll_by(win: Window, dx: f32, dy: f32) bool {
        let max_y = (this.content_height(win) - this.view.h).max(0)
        let ny = clamp32(this.scroll_y + dy, 0, max_y)
        let nx = this.wrap ? 0 : (this.scroll_x + dx).max(0)
        let moved = ny != this.scroll_y || nx != this.scroll_x
        this.scroll_y = ny
        this.scroll_x = nx
        return moved
    }

    // ---- Painting ----

    - fn paint(win: Window, p: Painter, b: Bounds) {
        this.view = b
        let theme = win.theme
        let lh = this.line_height()
        let gutter = this.gutter(win)
        let focused = this.focus_handle(win).is_focused()
        let rows = this.rows(win)
        let caret_row = this.row_index(win, this.row, this.col)
        if this.reveal {
            this.reveal = false
            let cy = caret_row.to(f32) * lh + 4
            if cy < this.scroll_y : this.scroll_y = cy - 4
            if cy + lh > this.scroll_y + b.h : this.scroll_y = cy + lh - b.h + 4
            let cx = this.x_of(win, this.row, this.col)
            let room = b.w - gutter - 8
            if cx < this.scroll_x : this.scroll_x = (cx - 20).max(0)
            if cx > this.scroll_x + room : this.scroll_x = cx - room + 20
        }
        if this.wrap : this.scroll_x = 0
        this.scroll_y = clamp32(this.scroll_y, 0, (this.content_height(win) - b.h).max(0))
        let first = floor32(this.scroll_y / lh).to(uint)
        let visible = ceil32(b.h / lh).to(uint) + 1
        let last = (first + visible).min(rows.length)
        let r1, c1, r2, c2 = this.selection()
        let selecting = this.has_selection()
        let text_x = b.x + gutter
        let text_h = round32(this.size * 1.4)
        if this.line_numbers : p.fill(.{ x: b.x, y: b.y, w: gutter - 8, h: b.h }, theme.background.opacity(0.35))
        // Colors are worked out per line, and reused for its wrapped rows
        let colors_line: uint = 0
        let colors: ?Array[(uint, Color)] = null
        each first .. last - first as vi {
            let vr = rows.get(vi) ! break
            let r = vr.line
            let y = b.y + 4 + vi.to(f32) * lh - this.scroll_y
            let content = this.line(r)
            let seg_end = vr.start + vr.len
            if this.line_numbers && vr.start == 0 {
                let label = (r + 1).to(String)
                let lw = p.text_width(label, this.size, .normal, this.font)
                p.text(b.x + gutter - 14 - lw, y + (lh - text_h) / 2, label, r == this.row && focused ? theme.text : theme.muted, this.size, .normal, this.font)
            }
            p.clip(.{ x: text_x - 2, y: b.y, w: b.w - gutter + 2, h: b.h })
            if this.find_open && this.find_input.text.length > 0 {
                let matches = this.find_matches()
                each matches as hit {
                    if hit.row != r : continue
                    let from = hit.col.max(vr.start)
                    let to = (hit.col + hit.len).min(seg_end)
                    if from < to {
                        let sx = this.width_of(win, r, vr.start, from)
                        let ex = this.width_of(win, r, vr.start, to)
                        p.fill(.{ x: text_x + sx - this.scroll_x, y: y, w: (ex - sx).max(2), h: lh }, theme.warning.opacity(0.32))
                    }
                }
            }
            if selecting && r >= r1 && r <= r2 {
                let from = r == r1 ? c1.max(vr.start) : vr.start
                let to = r == r2 ? c2.min(seg_end) : seg_end
                let ends_line = seg_end == content.length && r != r2
                if from <= to && !(r == r1 && c1 > seg_end) && !(r == r2 && c2 < vr.start) {
                    let sx = this.width_of(win, r, vr.start, from)
                    let ex = this.width_of(win, r, vr.start, to) + (ends_line ? this.size * 0.4 : 0)
                    p.fill(.{ x: text_x + sx - this.scroll_x, y: y, w: (ex - sx).max(2), h: lh }, theme.accent.opacity(focused ? 0.35 : 0.18))
                }
            }
            let ty = y + (lh - text_h) / 2
            let hl = this.highlight
            if isset(hl) && vr.len > 0 {
                if !isset(colors) || colors_line != r {
                    colors = hl(content)
                    colors_line = r
                }
                let x = text_x - this.scroll_x
                let at: uint = 0
                each colors ?? Array[(uint, Color)]{} as part {
                    let len, color = part
                    let part_end = (at + len).min(content.length)
                    let from = at.max(vr.start)
                    let to = part_end.min(seg_end)
                    if from < to {
                        let piece = content.range(from, to - from)
                        p.text(x, ty, piece, color, this.size, .normal, this.font)
                        x += this.width_of(win, r, from, to)
                    }
                    at = part_end
                    if at >= seg_end : break
                }
                if at < seg_end {
                    let from = at.max(vr.start)
                    p.text(x, ty, content.range(from, seg_end - from), theme.text, this.size, .normal, this.font)
                }
            } else if vr.len > 0 {
                p.text(text_x - this.scroll_x, ty, content.range(vr.start, vr.len), theme.text, this.size, .normal, this.font)
            }
            if focused && vi == caret_row {
                let cx = text_x + this.width_of(win, r, vr.start, this.col) - this.scroll_x
                if win.ime_text.length > 0 {
                    let iw = win.platform.text_width(win.ime_text, this.resolved())
                    p.fill(.{ x: cx, y: y, w: iw, h: lh }, theme.surface)
                    p.text(cx, ty, win.ime_text, theme.text, this.size, .normal, this.font)
                    p.fill(.{ x: cx, y: y + lh - 2, w: iw, h: 1.5 }, theme.accent)
                    cx += iw
                }
                let caret_b = Bounds{ x: cx, y: y + 2, w: 1.5, h: lh - 4 }
                p.fill(caret_b, theme.text)
                win.set_ime_area(caret_b)
            }
            p.unclip()
        }
        if this.lines.length == 1 && this.line(0).length == 0 && this.placeholder.length > 0 {
            p.text(text_x, b.y + 4 + (lh - text_h) / 2, this.placeholder, theme.muted, this.size, .normal, this.font)
        }
    }

    // ---- Editing ----

    - fn line(r: uint) String { return this.lines.get(r) !? "" }

    // The selection, from its start to its end
    - fn selection() (uint, uint, uint, uint) {
        if this.anchor_row < this.row || (this.anchor_row == this.row && this.anchor_col <= this.col) {
            return (this.anchor_row, this.anchor_col, this.row, this.col)
        }
        return (this.row, this.col, this.anchor_row, this.anchor_col)
    }

    - fn collapse() {
        this.anchor_row = this.row
        this.anchor_col = this.col
    }

    - fn delete_selection() {
        if !this.has_selection() : return
        let r1, c1, r2, c2 = this.selection()
        let start = this.line(r1).range(0, c1)
        let tail = this.line(r2)
        let rest = tail.range(c2, tail.length - c2)
        each 0 .. r2 - r1 : this.lines.remove(r1 + 1)
        this.lines.set(r1, start + rest) _
        this.row = r1
        this.col = c1
        this.collapse()
    }

    - fn changed() {
        this.version++
        this.reveal = true
        this.goal_x = -1
        let f = this.on_change
        if isset(f) : f(this.text)
    }

    - fn snapshot() Snapshot { return .{ text: this.text, row: this.row, col: this.col } }

    // Keeps the text before an edit for undo; typing a word is one step
    - fn remember(kind: String) {
        if kind == "type" && this.last_edit == "type" && !this.has_selection() : return
        this.undo_stack.append(this.snapshot())
        if this.undo_stack.length > 200 : this.undo_stack.remove(0)
        this.redo_stack.clear()
        this.last_edit = kind
    }

    - fn restore(snap: Snapshot) {
        let lines = snap.text.split("\n")
        this.lines = lines.length > 0 ? lines : Array[String]{ "" }
        this.row = snap.row.min(this.lines.length - 1)
        this.col = snap.col.min(this.line(this.row).length)
        this.collapse()
        this.last_edit = ""
        this.changed()
    }

    - fn move_to(r: uint, c: uint, select: bool) {
        this.row = r
        this.col = c
        if !select : this.collapse()
        this.reveal = true
        this.last_edit = ""
    }

    - fn vertical(win: Window, rows: int, select: bool) {
        if this.goal_x < 0 : this.goal_x = this.x_of(win, this.row, this.col)
        let count = this.rows(win).length
        let current = this.row_index(win, this.row, this.col)
        let target = (current.to(int) + rows).max(0).min(count.to(int) - 1).to(uint)
        let goal = this.goal_x
        let lx = this.view.x + this.gutter(win) - this.scroll_x + goal
        let ly = this.view.y + 4 + target.to(f32) * this.line_height() - this.scroll_y + 1
        let r, c = this.position_at(win, lx, ly)
        this.move_to(r, c, select)
        this.goal_x = goal
    }

    - fn key(win: Window, e: KeyEvent) {
        let m = e.modifiers
        let word = m.ctrl || m.alt
        let text = this.line(this.row)
        if m.secondary && !m.alt {
            let handled = true
            if e.key == .a {
                this.select_all()
            } else if e.key == .c {
                if this.has_selection() : win.set_clipboard(this.selected_text())
            } else if e.key == .x {
                if this.has_selection() && !this.read_only {
                    win.set_clipboard(this.selected_text())
                    this.remember("cut")
                    this.delete_selection()
                    this.changed()
                }
            } else if e.key == .v {
                this.insert(win.clipboard())
            } else if e.key == .z && !this.read_only {
                if m.shift : this.redo()
                else : this.undo()
            } else if e.key == .y && !this.read_only {
                this.redo()
            } else if e.key == .f {
                this.open_find()
                this.find_input.focus_handle(win).focus()
            } else if e.key == .h && !this.read_only {
                this.open_replace()
                this.find_input.focus_handle(win).focus()
            } else if e.key == .home {
                this.move_to(0, 0, m.shift)
            } else if e.key == .end {
                this.move_to(this.lines.length - 1, this.line(this.lines.length - 1).length, m.shift)
            } else {
                handled = false
            }
            if handled {
                e.stop_propagation()
                return
            }
        }
        match e.key {
            .left => {
                this.goal_x = -1
                if this.has_selection() && !m.shift {
                    let sel = this.selection()
                    this.move_to(sel[0], sel[1], false)
                } else if this.col == 0 {
                    if this.row > 0 : this.move_to(this.row - 1, this.line(this.row - 1).length, m.shift)
                } else {
                    let to = prev_boundary(text, this.col)
                    this.move_to(this.row, word ? word_start(text, to) : to, m.shift)
                }
            }
            .right => {
                this.goal_x = -1
                if this.has_selection() && !m.shift {
                    let sel = this.selection()
                    this.move_to(sel[2], sel[3], false)
                } else if this.col >= text.length {
                    if this.row + 1 < this.lines.length : this.move_to(this.row + 1, 0, m.shift)
                } else {
                    let to = next_boundary(text, this.col)
                    this.move_to(this.row, word ? word_end(text, to) : to, m.shift)
                }
            }
            .up => this.vertical(win, -1, m.shift)
            .down => this.vertical(win, 1, m.shift)
            .page_up => this.vertical(win, -(this.view.h / this.line_height()).to(int).max(1), m.shift)
            .page_down => this.vertical(win, (this.view.h / this.line_height()).to(int).max(1), m.shift)
            .home => {
                // First to the indentation, then to the line start
                let indent = leading_spaces(text)
                this.move_to(this.row, this.col == indent ? 0 : indent, m.shift)
                this.goal_x = -1
            }
            .end => {
                this.move_to(this.row, text.length, m.shift)
                this.goal_x = -1
            }
            .backspace => {
                if this.read_only : return
                if !this.has_selection() {
                    if this.col == 0 {
                        if this.row == 0 : return
                        this.anchor_row = this.row - 1
                        this.anchor_col = this.line(this.row - 1).length
                    } else {
                        this.anchor_row = this.row
                        let to = prev_boundary(text, this.col)
                        this.anchor_col = word ? word_start(text, to) : to
                    }
                }
                this.remember("delete")
                this.delete_selection()
                this.changed()
            }
            .delete => {
                if this.read_only : return
                if !this.has_selection() {
                    if this.col >= text.length {
                        if this.row + 1 >= this.lines.length : return
                        this.anchor_row = this.row + 1
                        this.anchor_col = 0
                    } else {
                        this.anchor_row = this.row
                        let to = next_boundary(text, this.col)
                        this.anchor_col = word ? word_end(text, to) : to
                    }
                }
                this.remember("delete")
                this.delete_selection()
                this.changed()
            }
            .enter => {
                if this.read_only : return
                // Keep the indentation of the line
                let indent = text.range(0, leading_spaces(text))
                this.insert("\n" + indent)
            }
            .tab => {
                if this.read_only : return
                if m.shift {
                    this.dedent()
                } else if this.has_selection() && this.row != this.anchor_row {
                    this.indent()
                } else {
                    this.insert(" ".repeat(this.tab_size))
                }
            }
            .escape => {
                if !this.has_selection() : return
                this.collapse()
            }
            default => return
        }
        e.stop_propagation()
    }

    - fn indent() {
        this.remember("indent")
        let sel = this.selection()
        let r1 = sel[0]
        let r2 = sel[2]
        let pad = " ".repeat(this.tab_size)
        each r1 .. r2 - r1 + 1 as r : this.lines.set(r, pad + this.line(r)) _
        this.anchor_col += this.tab_size
        this.col += this.tab_size
        this.changed()
    }

    - fn dedent() {
        this.remember("indent")
        let sel = this.selection()
        let r1 = sel[0]
        let r2 = sel[2]
        each r1 .. r2 - r1 + 1 as r {
            let text = this.line(r)
            let spaces = (leading_spaces(text)).min(this.tab_size)
            this.lines.set(r, text.range(spaces, text.length - spaces)) _
            if r == this.row : this.col = this.col - this.col.min(spaces)
            if r == this.anchor_row : this.anchor_col = this.anchor_col - this.anchor_col.min(spaces)
        }
        this.changed()
    }
}

fn leading_spaces(text: String) uint {
    let n: uint = 0
    while n < text.length && (text[n] == ' ' || text[n] == '\t') : n++
    return n
}
